generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                     @id @default(uuid())
  email                      String
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String
  avatar                     String?
  role                       UserRole                   @default(USER)
  status                     UserStatus                 @default(PENDING_VERIFICATION)
  emailVerified              Boolean                    @default(false)
  emailVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  stripeCustomerId           String?                    @unique
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  marketingConsent           Boolean                    @default(false)
  marketingConsentAt         DateTime?
  privacyAcceptedAt          DateTime?
  termsAcceptedAt            DateTime?
  termsVersion               String?
  passwordResetExpires       DateTime?
  passwordResetToken         String?
  passwordChangedAt          DateTime?
  emailVerificationExpiry    DateTime?
  emailVerificationToken     String?                    @unique
  notificationPreferences    Json?
  deletedAt                  DateTime?
  /// BC-ADMIN-SPEC-REAUDIT2-ARCHIVE-RESTORE-BYPASS-1 — persists the user's account
  /// status captured at soft-delete time (DELETE /:userId/account) so POST /:userId/restore
  /// can revive the user to their EXACT prior state instead of unconditionally ACTIVE.
  /// This preserves spec §1.1/§2.4 ARCHIVED-terminality across a DELETE→restore round-trip:
  /// an Archived user that is soft-deleted must come back Archived, not Active. Nullable;
  /// NULL for legacy rows deleted before this column existed (restore falls back to ACTIVE)
  /// and is cleared back to NULL on every restore.
  statusBeforeDelete         UserStatus?
  /// F-003: @deprecated — User.iban is a legacy field that may be out of sync with
  /// Wallet.payoutIban. For all payout and GDPR export operations, use Wallet.payoutIban
  /// as the authoritative source. This field is retained for backward compatibility only.
  iban                       String?
  ibanLastChangedAt          DateTime?
  marketingConsentEmail      Boolean                    @default(false)
  marketingConsentEmailAt    DateTime?
  marketingConsentPhone      Boolean                    @default(false)
  marketingConsentPhoneAt    DateTime?
  riskBucket                 RiskBucket?
  riskScore                  Int                        @default(0)
  riskOverriddenAt           DateTime?
  riskOverriddenBy           String?
  totpEnabledAt              DateTime?
  totpSecret                 String?
  totpPendingSecret          String?
  /// BC-ADMIN-2FA-RECOVERY-AND-FRONTEND-FIX-015 — one-time backup recovery codes.
  /// Stores bcrypt HASHES of single-use 2FA recovery codes (never plaintext).
  /// Plaintext is shown to the admin exactly once at 2FA-enable time and is not
  /// retrievable again. A successful recovery-code login consumes (removes) the
  /// matching hash from this array so it cannot be reused.
  totpRecoveryCodes          String[]                   @default([])
  mustChangePassword         Boolean                    @default(false)
  preferredLanguage          String                     @default("bg")
  lastActivityAt             DateTime?
  address                    String?
  city                       String?
  country                    String?
  pendingEmail               String?
  pendingEmailExpiry         DateTime?
  pendingEmailToken          String?                    @unique
  emailUnsubscribeToken      String?                    @unique
  rolesUpdatedAt             DateTime?
  auditLogs                  AuditLog[]
  bookings                   Booking[]
  cards                      Card[]
  conversations              ConversationParticipant[]
  assignedDisputes           Dispute[]                  @relation("DisputeAssignee")
  disputeCases               Dispute[]                  @relation("DisputeUser")
  disputeNotes               DisputeNote[]              @relation("DisputeNoteAuthor")
  favorites                  Favorite[]
  assignedTickets            HelpTicket[]               @relation("TicketAssignee")
  helpTickets                HelpTicket[]               @relation("TicketUser")
  loginHistory               LoginHistory[]
  loyaltyAccount             LoyaltyAccount?
  marketingListMembers       MarketingListMember[]
  messages                   Message[]
  notifications              Notification[]
  offerRedemptions           OfferRedemption[]
  partner                    Partner?
  partnerRequestNotes        PartnerRequestNote[]       @relation("PartnerRequestNoteAuthor")
  pushTokens                 PushToken[]
  receipts                   Receipt[]
  receiptUploadTokens        ReceiptUploadToken[]
  refreshTokens              RefreshToken[]
  reviews                    Review[]
  stickerScans               StickerScan[]
  ticketReplies              TicketReply[]              @relation("TicketReplies")
  transactions               Transaction[]
  grantedAdminRoles          UserAdminRole[]            @relation("GrantedRoles")
  adminRoles                 UserAdminRole[]
  permissionOverrides        UserPermissionOverride[]
  grantedPermissionOverrides UserPermissionOverride[]   @relation("GrantedOverrides")
  savedPaymentMethods        SavedPaymentMethod[]
  superAdminRequests         PendingSuperAdminRequest[] @relation("SuperAdminRequester")
  subscriptions              Subscription[]
  triggeredLinkResends       LinkResendLog[]            @relation("LinkResendLogActor")
  partnerStatusChanges       PartnerStatusChange[]      @relation("PartnerStatusChanger")
  criticalActionRequests     CriticalActionRequest[]    @relation("CriticalActionRequester")
  criticalActionResolutions  CriticalActionRequest[]    @relation("CriticalActionResolver")
  wallet                     Wallet?
  issuedActivationLinks      ActivationLink[]           @relation("ActivationLinkCreator")

  @@unique([email, role])
  @@index([email])
  @@index([role])
  @@index([status])
}

model PendingSuperAdminRequest {
  id               String    @id @default(uuid())
  email            String    @unique
  firstName        String?
  lastName         String?
  phone            String?
  passwordHash     String
  requestedById    String
  status           String    @default("PENDING")
  expiresAt        DateTime
  secondApproverId String?
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())
  requestedBy      User      @relation("SuperAdminRequester", fields: [requestedById], references: [id])

  @@index([requestedById])
  @@map("pending_super_admin_requests")
}

// Spec §10.3 — generic queue for critical admin actions that require a second
// SUPER_ADMIN to approve before execution. The `actionType` field identifies
// the class of action; `payload` carries the action-specific data (e.g. target
// user ID, new value). The resolver (approver or rejecter) acts on the pending
// row and then executes or discards the underlying operation.
//
// Supported actionTypes (extend as needed):
//   BULK_PAYOUT_OVERRIDE        — bulk payout amount override above the safety cap
//   PARTNER_ARCHIVE             — irreversible archive of an active partner
//   ADMIN_PERMISSION_GRANT      — granting a sensitive permission outside normal flow
//   DISCOUNT_RATE_CHANGE         — PARTNER_MANAGER proposes a new cashback rate; SUPER_ADMIN approval executes it
model CriticalActionRequest {
  id            String    @id @default(uuid())
  actionType    String // e.g. "BULK_PAYOUT_OVERRIDE", "PARTNER_ARCHIVE"
  requestedById String
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  payload       Json
  note          String?
  resolvedById  String?
  resolvedAt    DateTime?
  resolvedNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestedBy   User      @relation("CriticalActionRequester", fields: [requestedById], references: [id])
  resolvedBy    User?     @relation("CriticalActionResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("critical_action_requests")
}

model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  clientType   String?
  accountGroup String[] @default([])
  ip           String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([accountGroup], map: "RefreshToken_accountGroup_gin", type: Gin)
}

model Partner {
  id                    String                   @id @default(uuid())
  userId                String                   @unique
  businessName          String
  businessNameBg        String?
  category              String
  description           String?
  descriptionBg         String?
  logo                  String?
  coverImage            String?
  status                PartnerStatus            @default(PENDING)
  rating                Float                    @default(0)
  reviewCount           Int                      @default(0)
  website               String?
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  region                String?
  latitude              Float?
  longitude             Float?
  openingHours          String?
  features              String?
  amenities             String?
  joinedAt              DateTime                 @default(now())
  verifiedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  discountRate          Float?
  partnerTypeId         String?
  pendingChanges        Json?
  pendingChangesAt      DateTime?
  categories            String[]              @default([])
  assignedAdminId       String?
  isVisible             Boolean                  @default(true)
  requestStatus         PartnerRequestStatus?
  // Spec §5.1 v1.1 — declared venue count bucket at application time. Stored as
  // an enum so the value cannot drift via non-validating callers (bulk import,
  // future scripts). The DB column maps to the string forms shown in the UI
  // ("1" / "2-5" / "6-10" / "11+") via per-value @map directives below.
  requestObjectCount    PartnerVenueCountBucket?
  // Spec §2.3 — partner-application fields captured on the public RegisterPartnerPage.
  // Sent inside businessInfo. Nullable/defaulted so the migration is additive and
  // safe on the shared DB. participationLevel is one of "basic" | "active" | "growth"
  // (validated at the auth.validator layer); acceptPrivacy records the separate
  // privacy-policy consent; additionalInfo is free text.
  participationLevel    String?
  acceptPrivacy         Boolean?                 @default(false)
  additionalInfo        String?
  // @internal — internal risk flag, never serialize to external callers (spec §11.3, Clash 5.1).
  // This field is internal-only and must never be selected into partner-facing responses.
  // Partner routes use explicit `select` allowlists that omit it; admin-only reads include it explicitly.
  hasRiskFlag           Boolean                  @default(false)
  onboardingCompletedAt DateTime?
  // Spec §1.1, §1.3, §14.1 — sub-classification for PAUSED/SUSPENDED status values so
  // the downstream display layer can show the correct Bulgarian label (Пауза vs Спрян)
  // without extending the API contract beyond the three canonical spec values.
  // Added in migration 20260602100000.
  // Examples: "VOLUNTARY_PAUSE" | "ADMIN_SUSPENSION" | "FAILED_PAYMENT_SUSPENSION"
  statusReason          String?
  bookings              Booking[]
  marketingListMembers  MarketingListMember[]
  offers                Offer[]
  partnerType           PartnerType?             @relation(fields: [partnerTypeId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashbackPayments      PartnerCashbackPayment[]
  requestNotes          PartnerRequestNote[]
  reviews               Review[]
  transactions          Transaction[]
  venues                Venue[]
  activationLinks       ActivationLink[]
  statusChanges         PartnerStatusChange[]
  helpTickets           HelpTicket[]             @relation("PartnerHelpTickets")

  @@index([category])
  @@index([partnerTypeId])
  @@index([status])
  @@index([city])
  @@index([hasRiskFlag])
  @@index([status, category, city])
  @@index([categories], map: "Partner_categories_gin", type: Gin)
}

model PartnerCashbackPayment {
  id                String                @id @default(uuid())
  partnerId         String
  month             String
  totalCashbackOwed Float                 @default(0)
  paidAt            DateTime?
  paidBy            String?
  notes             String?
  status            CashbackPaymentStatus @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  // admin-only — internal margin component; NEVER include in partner API responses.
  // Spec §7.4, §11.3, Clash 10.6: margin % and cashback % components are
  // internal-only and must never be shown to the partner in any portal view.
  // This field is internal-only: partner routes use explicit `select` allowlists
  // that omit it, so it cannot leak via accidental spread or select-*. Admin-only
  // reads include it explicitly in their select.
  // @internal — never serialize to external callers
  marginAmount      Float                 @default(0)
  contractedRate    Float?
  turnoverAmount    Float                 @default(0)
  invoiceNumber     String?               @unique
  partner           Partner               @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, month])
  @@index([status])
  @@index([month])
}

// Spec §5.2, §9.5 v1.1 — partner activation link.
// One-time token, valid 72h, only admin can resend. Each new link invalidates
// the previous (enforced in service by setting invalidatedAt on the old row,
// inside a transaction with the create of the new row — see activationLink.service.ts).
// On resend a LinkResendLog row is appended for audit (§10.4).
//
// `reason` distinguishes an initial issuance (post-approve) from an admin
// resend so the drawer can render the audit timeline accurately (resend count,
// who clicked what, etc.).
// `emailSentAt` / `emailError` are stamped after the email-layer call returns
// so admins can see at a glance whether the partner actually received the
// link (M5 in the audit).
model ActivationLink {
  id            String               @id @default(uuid())
  partnerId     String
  token         String               @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  reason        ActivationLinkReason @default(INITIAL)
  emailSentAt   DateTime?
  emailError    String?
  // Spec §9.3 — admin who created/issued this activation link. FK with SetNull on
  // delete so the audit record is preserved even if the admin user is removed.
  // Matches the PartnerStatusChange.changedBy pattern.
  createdById   String?
  createdAt     DateTime             @default(now())
  partner       Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  createdBy     User?                @relation("ActivationLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([expiresAt])
}

// Spec §10.4 v1.1 — audit trail for activation / verification link resends.
// Kept separate from AuditLog because the link domain has its own primary
// key relationship and reads (e.g., "show resend history" on partner row).
//
// `actorId` is nullable for two reasons: (1) some link types (EMAIL_VERIFICATION,
// PASSWORD_RESET) may be self-service triggered, in which case there is no
// admin actor; (2) historical rows from before the actor-FK was added may
// have orphaned ids. Linking via @relation is OPTIONAL — if the User is
// deleted we keep the row but null the actor (set-null on delete).
model LinkResendLog {
  id        String   @id @default(uuid())
  linkType  String // "PARTNER_ACTIVATION" | "EMAIL_VERIFICATION" | "PASSWORD_RESET"
  subjectId String // partnerId or userId — interpreted via linkType
  actorId   String?
  createdAt DateTime @default(now())
  actor     User?    @relation("LinkResendLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([linkType, subjectId])
  @@index([createdAt])
}

// Spec §5.3 v1.1 + §10.4 — partner status transition log. Drives the
// "История на промени" view and is the source for audit reads when an
// admin asks "why is partner X suspended".
model PartnerStatusChange {
  id          String        @id @default(uuid())
  partnerId   String
  fromStatus  PartnerStatus
  toStatus    PartnerStatus
  reason      String?
  changedById String?
  createdAt   DateTime      @default(now())
  partner     Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  changedBy   User?         @relation("PartnerStatusChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([partnerId, createdAt])
  @@index([changedById])
}

model PartnerRequestNote {
  id         String   @id @default(uuid())
  partnerId  String
  authorId   String
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  author     User     @relation("PartnerRequestNoteAuthor", fields: [authorId], references: [id])
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([createdAt])
}

model Venue {
  id                  String               @id @default(uuid())
  partnerId           String
  name                String
  nameBg              String?
  address             String
  city                String
  region              String?
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  description         String?
  descriptionBg       String?
  images              String?
  openingHours        String?
  capacity            Int?
  features            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  menuImages          String?
  menuRejectionReason String?
  menuReviewedAt      DateTime?
  menuReviewedBy      String?
  menuStatus          MenuStatus           @default(NONE)
  menuSubmittedAt     DateTime?
  menuUrl             String?
  pendingMenuUrl      String?
  venueStatus         VenueStatus          @default(ACTIVE)
  venueStatusAt       DateTime?
  venueStatusNote     String?
  bookings            Booking[]
  receipts            Receipt[]
  stickers            Sticker[]
  stickerLocations    StickerLocation[]
  stickerScans        StickerScan[]
  transactions        Transaction[]
  partner             Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  stickerConfig       VenueStickerConfig?
  statusHistory       VenueStatusHistory[]

  @@index([partnerId])
  @@index([city])
  @@index([menuStatus])
  @@index([venueStatus])
}

// Spec §5.4 — "История: Кога и защо е сменян". Per status change of a venue
// we append a row here so the locations page can render a full timeline of
// who changed what, when, and why. We do NOT FK changedById to User: this
// mirrors Partner.assignedAdminId and keeps the User model's relation list
// untouched. The actor is hydrated by a follow-up findMany when read.
model VenueStatusHistory {
  id          String      @id @default(uuid())
  venueId     String
  fromStatus  VenueStatus
  toStatus    VenueStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, createdAt])
}

model PartnerType {
  id              String           @id @default(uuid())
  name            String           @unique
  nameBg          String?
  description     String?
  descriptionBg   String?
  maxDiscountRate Float
  color           String           @default("#6b7280")
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  partners        Partner[]
  planAccess      PlanTypeAccess[]

  @@index([isActive])
  @@index([sortOrder])
}

model PlanTypeAccess {
  id            String           @id @default(uuid())
  plan          SubscriptionPlan
  partnerTypeId String
  canView       Boolean          @default(true)
  canRedeem     Boolean          @default(true)
  partnerType   PartnerType      @relation(fields: [partnerTypeId], references: [id], onDelete: Cascade)

  @@unique([plan, partnerTypeId])
  @@index([plan])
  @@index([partnerTypeId])
}

model Offer {
  id                String            @id @default(uuid())
  partnerId         String
  title             String
  titleBg           String?
  description       String
  descriptionBg     String?
  type              OfferType
  discountPercent   Float?
  discountAmount    Float?
  // @internal — internal cashback rate component, never serialize to partner or user callers (spec §11.3, Clash 10.6)
  // Spec §8a: Offer model has no approved spec; this field is internal-only and must
  // never be selected into partner- or user-facing responses until the spec is confirmed.
  // Partner/user routes use explicit `select` allowlists that omit it; admin-only reads include it explicitly.
  cashbackPercent   Float?
  pointsMultiplier  Float?
  minPurchase       Float?
  maxDiscount       Float?
  termsConditions   String?
  termsConditionsBg String?
  image             String?
  status            OfferStatus       @default(DRAFT)
  isFeatured        Boolean           @default(false)
  featuredOrder     Int?
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?
  usageCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tags              String?
  partner           Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  redemptions       OfferRedemption[]
  transactions      Transaction[]

  @@index([partnerId])
  @@index([status])
  @@index([isFeatured])
  @@index([startDate])
  @@index([endDate])
  @@index([status, isFeatured, startDate, endDate])
}

model OfferRedemption {
  id         String   @id @default(uuid())
  offerId    String
  userId     String
  code       String   @unique
  redeemedAt DateTime @default(now())
  expiresAt  DateTime
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id                   String                @id @default(uuid())
  planCode             String                @unique
  displayName          String
  displayNameBg        String?
  priceWeeklyEur       Int?
  priceMonthlyEur      Int?
  priceYearlyEur       Int
  cashbackRate         Float
  stickerBonus         Float                 @default(0)
  features             String?
  featuresBg           String?
  cardType             String                @default("silver")
  isFeatured           Boolean               @default(false)
  badgeText            String?
  badgeTextBg          String?
  displayOrder         Int                   @default(0)
  hasWeeklyOption      Boolean               @default(false)
  hasMonthlyOption     Boolean               @default(true)
  hasYearlyOption      Boolean               @default(true)
  yearlyDiscountPct    Int                   @default(20)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pendingSubscriptions PendingSubscription[]
  subscriptions        Subscription[]

  @@index([planCode])
  @@index([isActive])
  @@index([displayOrder])
  @@map("plans")
}

model Transaction {
  id                String             @id @default(uuid())
  userId            String
  subscriptionId    String? // Spec §4.2/4.3 — subscription active at transaction time
  partnerId         String?
  venueId           String?
  offerId           String?
  bookingId         String?
  cardId            String?
  type              TransactionType
  status            TransactionStatus
  amount            Float
  // admin-only — internal margin; NEVER include in partner API responses.
  // Spec §4.3 — persisted at creation; immutable to rate changes.
  // Spec §11.3 / §7.4: margin % and cashback % components are internal-only.
  // This field is internal-only and must never be selected into partner-facing
  // responses; partner routes use explicit `select` allowlists that omit it.
  // Admin-only reads include it explicitly in their select.
  // @internal — never serialize to external callers
  marginAmount      Float?
  discount          Float?
  discountAmount    Float?
  finalAmount       Float?
  currency          String             @default("BGN")
  paymentMethod     PaymentMethod
  paymentIntentId   String?
  stripePaymentId   String?            @unique
  description       String?
  descriptionBg     String?
  metadata          String?
  loyaltyPoints     Int?
  cashbackAmount    Float?
  processingFee     Float?
  netAmount         Float?
  refundedAmount    Float?
  refundedAt        DateTime?
  completedAt       DateTime?
  // @internal — internal risk score, never serialize to external callers (spec §11.3, Clash 5.1).
  // This field is internal-only and must never be selected into partner- or user-facing
  // responses; those routes use explicit `select` allowlists that omit it. Admin-only reads include it explicitly.
  riskScore         Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  receipt           Receipt?
  stickerScan       StickerScan?
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  offer             Offer?             @relation(fields: [offerId], references: [id])
  partner           Partner?           @relation(fields: [partnerId], references: [id])
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id])
  venue             Venue?             @relation(fields: [venueId], references: [id])
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([subscriptionId])
  @@index([partnerId])
  @@index([venueId])
  @@index([cardId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Wallet {
  id                    String              @id @default(uuid())
  userId                String              @unique
  balance               Float               @default(0.0)
  availableBalance      Float               @default(0.0)
  pendingBalance        Float               @default(0.0)
  currency              String              @default("BGN")
  isLocked              Boolean             @default(false)
  lockedReason          String?
  lockedAt              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  payoutIban            String?
  payoutBeneficiaryName String?
  transactions          WalletTransaction[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id                    String                  @id @default(uuid())
  walletId              String
  type                  WalletTransactionType
  amount                Float
  balanceBefore         Float
  balanceAfter          Float
  currency              String                  @default("BGN")
  status                WalletTransactionStatus @default(PENDING)
  description           String?
  metadata              String?
  transactionId         String?                 @unique
  stripePaymentIntentId String?
  receiptId             String?
  stickerScanId         String?
  createdAt             DateTime                @default(now())
  cashbackExpiresAt     DateTime?
  cashbackPaidAt        DateTime?
  // Spec §4.4 v1.1 — entry-based lifecycle. Only set for CASHBACK_CREDIT rows.
  // clearedAt drives the 60-day rolling window (per spec, validity starts at
  // Cleared, not at original transaction date). voided* are populated when a
  // risk review rejects the originating transaction (§7.1).
  cashbackStatus        CashbackEntryStatus?
  clearedAt             DateTime?
  lockedAt              DateTime?
  voidedAt              DateTime?
  voidedReason          String?
  voidedByUserId        String?
  payoutIbanSnapshot    String?
  receipt               Receipt?                @relation(fields: [receiptId], references: [id])
  stickerScan           StickerScan?            @relation(fields: [stickerScanId], references: [id])
  transaction           Transaction?            @relation(fields: [transactionId], references: [id])
  wallet                Wallet                  @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([cashbackExpiresAt])
  @@index([stripePaymentIntentId])
  @@index([cashbackStatus])
  @@map("wallet_transactions")
}

model Subscription {
  id                        String             @id @default(uuid())
  userId                    String
  plan                      SubscriptionPlan
  status                    SubscriptionStatus
  stripeSubscriptionId      String?            @unique
  stripePriceId             String?
  stripeCustomerId          String?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  cancelAtPeriodEnd         Boolean            @default(false)
  cancelAt                  DateTime?
  canceledAt                DateTime?
  trialStart                DateTime?
  trialEnd                  DateTime?
  metadata                  String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  payseraOrderId            String?            @unique
  planId                    String?
  autoRenewal               Boolean            @default(true)
  pauseEndsAt               DateTime?
  // Stripe-only: incremented by the stripe.service webhook handler on each
  // invoice.payment_failed event; reset to 0 on payment success or on
  // FAILED_PAYMENT transition. Always 0 for Paysera subscriptions (Paysera
  // has no automatic retry loop — the single-attempt model is enforced by
  // paysera-renewal.ts which transitions directly to FAILED_PAYMENT).
  retryAttempt              Int                @default(0)
  trialRefundEligibleUntil  DateTime?
  trialRefundUsed           Boolean            @default(false)
  lastRenewalReminderSentAt DateTime?
  // Spec §4.2 v1.1 — set when the single renewal attempt fails. While non-null
  // and status=FAILED_PAYMENT, scanning is blocked and payouts are gated.
  failedPaymentAt           DateTime?
  // Stamped when this FAILED_PAYMENT row is transitioned to EXPIRED because the
  // user gained a newer ACTIVE/TRIALING subscription. Audit-only — kept so
  // forensic queries can distinguish "naturally expired" from "force-cleared".
  failedPaymentClearedAt    DateTime?
  // Spec §8.3 — bitmask of reminders already sent for the current period:
  // bit 0 = 3d, bit 1 = 1d, bit 2 = day-of. Reset on renewal.
  renewalRemindersSent      Int                @default(0)
  planDetails               Plan?              @relation(fields: [planId], references: [id])
  user                      User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions              Transaction[]

  @@index([userId])
  @@index([status])
  @@index([plan])
  @@index([planId])
  @@index([payseraOrderId])
  @@map("subscriptions")
}

