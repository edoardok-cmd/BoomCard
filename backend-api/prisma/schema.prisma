generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                     @id @default(uuid())
  email                      String
  passwordHash               String
  firstName                  String
  lastName                   String
  phone                      String
  avatar                     String?
  role                       UserRole                   @default(USER)
  status                     UserStatus                 @default(PENDING_VERIFICATION)
  emailVerified              Boolean                    @default(false)
  emailVerifiedAt            DateTime?
  phoneVerified              Boolean                    @default(false)
  phoneVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  stripeCustomerId           String?                    @unique
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  marketingConsent           Boolean                    @default(false)
  marketingConsentAt         DateTime?
  privacyAcceptedAt          DateTime?
  termsAcceptedAt            DateTime?
  termsVersion               String?
  passwordResetExpires       DateTime?
  passwordResetToken         String?
  passwordChangedAt          DateTime?
  emailVerificationExpiry    DateTime?
  emailVerificationToken     String?                    @unique
  notificationPreferences    Json?
  deletedAt                  DateTime?
  /// F-003: @deprecated — User.iban is a legacy field that may be out of sync with
  /// Wallet.payoutIban. For all payout and GDPR export operations, use Wallet.payoutIban
  /// as the authoritative source. This field is retained for backward compatibility only.
  iban                       String?
  ibanLastChangedAt          DateTime?
  marketingConsentEmail      Boolean                    @default(false)
  marketingConsentEmailAt    DateTime?
  marketingConsentPhone      Boolean                    @default(false)
  marketingConsentPhoneAt    DateTime?
  riskBucket                 RiskBucket?
  riskScore                  Int                        @default(0)
  totpEnabledAt              DateTime?
  totpSecret                 String?
  preferredLanguage          String                     @default("bg")
  lastActivityAt             DateTime?
  city                       String?
  country                    String?
  pendingEmail               String?
  pendingEmailExpiry         DateTime?
  pendingEmailToken          String?                    @unique
  totpPendingSecret          String?
  mustChangePassword         Boolean                    @default(false)
  emailUnsubscribeToken      String?                    @unique
  rolesUpdatedAt             DateTime?
  address                    String?
  riskOverriddenAt           DateTime?
  riskOverriddenBy           String?
  /// BC-ADMIN-2FA-RECOVERY-AND-FRONTEND-FIX-015 — one-time backup recovery codes.
  /// Stores bcrypt HASHES of single-use 2FA recovery codes (never plaintext).
  /// Plaintext is shown to the admin exactly once at 2FA-enable time and is not
  /// retrievable again. A successful recovery-code login consumes (removes) the
  /// matching hash from this array so it cannot be reused.
  totpRecoveryCodes          String[]                   @default([])
  /// BC-ADMIN-SPEC-REAUDIT2-ARCHIVE-RESTORE-BYPASS-1 — persists the user's account
  /// status captured at soft-delete time (DELETE /:userId/account) so POST /:userId/restore
  /// can revive the user to their EXACT prior state instead of unconditionally ACTIVE.
  /// This preserves spec §1.1/§2.4 ARCHIVED-terminality across a DELETE→restore round-trip:
  /// an Archived user that is soft-deleted must come back Archived, not Active. Nullable;
  /// NULL for legacy rows deleted before this column existed (restore falls back to ACTIVE)
  /// and is cleared back to NULL on every restore.
  statusBeforeDelete         UserStatus?
  issuedActivationLinks      ActivationLink[]           @relation("ActivationLinkCreator")
  auditLogs                  AuditLog[]
  bookings                   Booking[]
  cards                      Card[]
  conversations              ConversationParticipant[]
  assignedDisputes           Dispute[]                  @relation("DisputeAssignee")
  disputeCases               Dispute[]                  @relation("DisputeUser")
  disputeNotes               DisputeNote[]              @relation("DisputeNoteAuthor")
  favorites                  Favorite[]
  assignedTickets            HelpTicket[]               @relation("TicketAssignee")
  helpTickets                HelpTicket[]               @relation("TicketUser")
  triggeredLinkResends       LinkResendLog[]            @relation("LinkResendLogActor")
  loginHistory               LoginHistory[]
  loyaltyAccount             LoyaltyAccount?
  marketingListMembers       MarketingListMember[]
  messages                   Message[]
  notifications              Notification[]
  offerRedemptions           OfferRedemption[]
  partner                    Partner?
  PartnerApplication         PartnerApplication[]
  partnerRequestNotes        PartnerRequestNote[]       @relation("PartnerRequestNoteAuthor")
  partnerStatusChanges       PartnerStatusChange[]      @relation("PartnerStatusChanger")
  pushTokens                 PushToken[]
  receipts                   Receipt[]
  receiptUploadTokens        ReceiptUploadToken[]
  refreshTokens              RefreshToken[]
  reviews                    Review[]
  ReviewVote                 ReviewVote[]
  stickerScans               StickerScan[]
  ticketReplies              TicketReply[]              @relation("TicketReplies")
  transactions               Transaction[]
  grantedAdminRoles          UserAdminRole[]            @relation("GrantedRoles")
  adminRoles                 UserAdminRole[]
  grantedPermissionOverrides UserPermissionOverride[]   @relation("GrantedOverrides")
  permissionOverrides        UserPermissionOverride[]
  criticalActionRequests     CriticalActionRequest[]    @relation("CriticalActionRequester")
  criticalActionResolutions  CriticalActionRequest[]    @relation("CriticalActionResolver")
  savedPaymentMethods        SavedPaymentMethod[]
  superAdminRequests         PendingSuperAdminRequest[] @relation("SuperAdminRequester")
  subscriptions              Subscription[]
  wallet_transactions        WalletTransaction[]
  wallet                     Wallet?

  @@unique([email, role])
  // BC-QA-032 / BC-QA-051 — (phone, role) uniqueness, but only for rows that
  // actually carry a phone number.
  //
  // The `where:` clause is NOT optional decoration. "User"."phone" is NOT NULL,
  // and the way "no phone on file" is represented in this database is the EMPTY
  // STRING — which, unlike NULL, is not distinct from itself. A TOTAL
  // `@@unique([phone, role])` is therefore unsatisfiable while any two accounts
  // of the same role have a blank phone. In production that bucket is 134 rows
  // and holds every live ACTIVE partner, all three SUPER_ADMINs and real end
  // users. The plain `@@unique([phone, role])` that used to sit here is exactly
  // what produced the ~10-day BC-QA-051 production outage: its migration
  // aborted, `prisma migrate deploy` exited 1, and because deploy is chained
  // into the Fly start command with `&&`, the API never started.
  //
  // It also matches what the application already does: AuthService.register's
  // duplicate-phone pre-check is guarded by `if (sanitizedPhone)`, i.e. it
  // deliberately does not treat a blank phone as a collision.
  //
  // `raw(...)` here requires `partialIndexes` in the generator's previewFeatures
  // (already enabled at the top of this file). Verified on prisma@7.7.0:
  //   * `prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script`
  //     emits exactly
  //       CREATE UNIQUE INDEX "User_phone_role_key"
  //         ON "User"("phone", "role") WHERE (btrim(phone) <> '');
  //     which is what 20260810160000_add_user_phone_role_unique creates, so a
  //     clean `migrate deploy` and this schema agree.
  //   * Against a database in the post-fix state,
  //     `prisma migrate diff --from-config-datasource --to-schema …` reports NO
  //     change for this index — no drift. Writing it as a plain
  //     `@@unique([phone, role])` instead produces
  //       DROP INDEX "User_phone_role_key";
  //       CREATE UNIQUE INDEX "User_phone_role_key" ON "User"("phone","role");
  //     i.e. the next `prisma migrate dev` would hand you a migration that
  //     re-creates the outage. Omitting the attribute entirely produces
  //       DROP INDEX "User_phone_role_key";
  //     i.e. it would silently drop the enforcement. Neither alternative is safe.
  //
  // KNOWN LIMITATION of declaring a partial index this way: the generated client
  // still exposes `where: { phone_role: { phone, role } }` as if the pair were
  // TOTALLY unique. For a blank phone that predicate matches many rows, so that
  // accessor is only sound for non-blank phones. Nothing in this repo uses it
  // (grep `phone_role`: zero hits outside comments) — do not start.
  //
  // Violations surface as Prisma P2002. The index NAME is deliberately
  // unchanged ("User_phone_role_key") because isPhoneRoleUniqueViolation() in
  // src/services/auth.service.ts matches on that literal.
  //
  // CAVEAT, measured rather than assumed: on prisma@7.7.0 driving
  // @prisma/adapter-pg (this app's setup — see src/lib/prisma.ts) the P2002
  // error carries NO `meta.target` at all. It looks like:
  //   { modelName: "User",
  //     driverAdapterError: { cause: { originalCode: "23505",
  //       originalMessage: 'duplicate key value violates unique constraint
  //                         "User_phone_role_key"',
  //       kind: "UniqueConstraintViolation",
  //       constraint: { fields: ["phone", "role"] } } } }
  // so isPhoneRoleUniqueViolation() returns FALSE today. This is NOT caused by
  // the partial index: the untouched TOTAL @@unique([email, role]) behaves
  // identically, and isEmailRoleUniqueViolation() is equally dead. It is a
  // pre-existing Prisma-7/driver-adapter regression in both helpers, tracked
  // separately. Enforcement itself is unaffected — the duplicate is still
  // rejected; only the 409-mapping is.
  @@unique([phone, role], where: raw("btrim(phone) <> ''"))
  @@index([email])
  @@index([role])
  @@index([status])
}

model PendingSuperAdminRequest {
  id               String    @id @default(uuid())
  email            String    @unique
  firstName        String?
  lastName         String?
  phone            String?
  passwordHash     String
  requestedById    String
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  resolvedAt       DateTime?
  secondApproverId String?
  status           String    @default("PENDING")
  requestedBy      User      @relation("SuperAdminRequester", fields: [requestedById], references: [id])

  @@index([requestedById])
  @@index([expiresAt])
  @@index([status])
  @@map("pending_super_admin_requests")
}

model CriticalActionRequest {
  id            String    @id @default(uuid())
  actionType    String
  requestedById String
  status        String    @default("PENDING")
  payload       Json
  note          String?
  resolvedById  String?
  resolvedAt    DateTime?
  resolvedNote  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  requestedBy   User      @relation("CriticalActionRequester", fields: [requestedById], references: [id])
  resolvedBy    User?     @relation("CriticalActionResolver", fields: [resolvedById], references: [id])

  @@index([status])
  @@index([requestedById])
  @@index([createdAt])
  @@map("critical_action_requests")
}

model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  clientType   String?
  accountGroup String[] @default([])
  ip           String?
  userAgent    String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([accountGroup], map: "RefreshToken_accountGroup_gin", type: Gin)
}

model Partner {
  id                    String                   @id @default(uuid())
  userId                String                   @unique
  businessName          String
  businessNameBg        String?
  category              String
  description           String?
  descriptionBg         String?
  logo                  String?
  coverImage            String?
  status                PartnerStatus            @default(PENDING)
  rating                Float                    @default(0)
  reviewCount           Int                      @default(0)
  website               String?
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  region                String?
  latitude              Float?
  longitude             Float?
  openingHours          String?
  features              String?
  amenities             String?
  joinedAt              DateTime                 @default(now())
  verifiedAt            DateTime?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  discountRate          Float?
  partnerTypeId         String?
  pendingChanges        Json?
  pendingChangesAt      DateTime?
  categories            String[]
  assignedAdminId       String?
  isVisible             Boolean                  @default(true)
  requestStatus         PartnerRequestStatus?
  onboardingCompletedAt DateTime?
  requestObjectCount    PartnerVenueCountBucket?
  hasRiskFlag           Boolean                  @default(false)
  statusReason          String?
  participationLevel    String?
  acceptPrivacy         Boolean?                 @default(false)
  additionalInfo        String?
  activationLinks       ActivationLink[]
  bookings              Booking[]
  helpTickets           HelpTicket[]             @relation("PartnerHelpTickets")
  marketingListMembers  MarketingListMember[]
  offers                Offer[]
  partnerType           PartnerType?             @relation(fields: [partnerTypeId], references: [id])
  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  PartnerApplication    PartnerApplication?
  cashbackPayments      PartnerCashbackPayment[]
  requestNotes          PartnerRequestNote[]
  statusChanges         PartnerStatusChange[]
  reviews               Review[]
  transactions          Transaction[]
  venues                Venue[]
  connectedIntegrations ConnectedIntegration[]

  @@index([category])
  @@index([partnerTypeId])
  @@index([status])
  @@index([city])
  @@index([hasRiskFlag])
  @@index([status, category, city])
  @@index([categories], map: "Partner_categories_gin", type: Gin)
}

model PartnerCashbackPayment {
  id                String                @id @default(uuid())
  partnerId         String
  month             String
  totalCashbackOwed Float                 @default(0)
  paidAt            DateTime?
  paidBy            String?
  notes             String?
  status            CashbackPaymentStatus @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  marginAmount      Float                 @default(0)
  contractedRate    Float?
  turnoverAmount    Float                 @default(0)
  invoiceNumber     String?               @unique
  partner           Partner               @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, month])
  @@index([status])
  @@index([month])
}

model ActivationLink {
  id            String               @id @default(uuid())
  partnerId     String
  token         String               @unique
  expiresAt     DateTime
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  emailError    String?
  emailSentAt   DateTime?
  reason        ActivationLinkReason @default(INITIAL)
  createdBy     User?                @relation("ActivationLinkCreator", fields: [createdById], references: [id])
  partner       Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([expiresAt])
}

model LinkResendLog {
  id        String   @id @default(uuid())
  linkType  String
  subjectId String
  actorId   String?
  createdAt DateTime @default(now())
  actor     User?    @relation("LinkResendLogActor", fields: [actorId], references: [id])

  @@index([linkType, subjectId])
  @@index([createdAt])
}

model PartnerStatusChange {
  id          String        @id @default(uuid())
  partnerId   String
  fromStatus  PartnerStatus
  toStatus    PartnerStatus
  reason      String?
  changedById String?
  createdAt   DateTime      @default(now())
  changedBy   User?         @relation("PartnerStatusChanger", fields: [changedById], references: [id])
  partner     Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([partnerId, createdAt])
  @@index([changedById])
}

model PartnerRequestNote {
  id         String   @id @default(uuid())
  partnerId  String
  authorId   String
  body       String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())
  author     User     @relation("PartnerRequestNoteAuthor", fields: [authorId], references: [id])
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([createdAt])
}

model Venue {
  id                  String               @id @default(uuid())
  partnerId           String
  name                String
  nameBg              String?
  address             String
  city                String
  region              String?
  latitude            Float?
  longitude           Float?
  phone               String?
  email               String?
  description         String?
  descriptionBg       String?
  images              String?
  openingHours        String?
  capacity            Int?
  features            String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  menuImages          String?
  menuRejectionReason String?
  menuReviewedAt      DateTime?
  menuReviewedBy      String?
  menuStatus          MenuStatus           @default(NONE)
  menuSubmittedAt     DateTime?
  menuUrl             String?
  pendingMenuUrl      String?
  venueStatus         VenueStatus          @default(ACTIVE)
  venueStatusAt       DateTime?
  venueStatusNote     String?
  bookings            Booking[]
  receipts            Receipt[]
  stickers            Sticker[]
  stickerLocations    StickerLocation[]
  stickerScans        StickerScan[]
  transactions        Transaction[]
  partner             Partner              @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  statusHistory       VenueStatusHistory[]
  stickerConfig       VenueStickerConfig?

  @@index([partnerId])
  @@index([city])
  @@index([menuStatus])
  @@index([venueStatus])
}

model VenueStatusHistory {
  id          String      @id @default(uuid())
  venueId     String
  fromStatus  VenueStatus
  toStatus    VenueStatus
  note        String?
  changedById String?
  createdAt   DateTime    @default(now())
  venue       Venue       @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([venueId, createdAt])
}

model PartnerType {
  id              String           @id @default(uuid())
  name            String           @unique
  nameBg          String?
  description     String?
  descriptionBg   String?
  maxDiscountRate Float
  color           String           @default("#6b7280")
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  partners        Partner[]
  planAccess      PlanTypeAccess[]

  @@index([isActive])
  @@index([sortOrder])
}

model PlanTypeAccess {
  id            String           @id @default(uuid())
  plan          SubscriptionPlan
  partnerTypeId String
  canView       Boolean          @default(true)
  canRedeem     Boolean          @default(true)
  partnerType   PartnerType      @relation(fields: [partnerTypeId], references: [id], onDelete: Cascade)

  @@unique([plan, partnerTypeId])
  @@index([plan])
  @@index([partnerTypeId])
}

model Offer {
  id                String            @id @default(uuid())
  partnerId         String
  title             String
  titleBg           String?
  description       String
  descriptionBg     String?
  type              OfferType
  discountPercent   Float?
  discountAmount    Float?
  cashbackPercent   Float?
  pointsMultiplier  Float?
  minPurchase       Float?
  maxDiscount       Float?
  termsConditions   String?
  termsConditionsBg String?
  image             String?
  status            OfferStatus       @default(DRAFT)
  isFeatured        Boolean           @default(false)
  featuredOrder     Int?
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?
  usageCount        Int               @default(0)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  tags              String?
  partner           Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  redemptions       OfferRedemption[]
  transactions      Transaction[]

  @@index([partnerId])
  @@index([status])
  @@index([isFeatured])
  @@index([startDate])
  @@index([endDate])
  @@index([status, isFeatured, startDate, endDate])
}

model OfferRedemption {
  id         String   @id @default(uuid())
  offerId    String
  userId     String
  code       String   @unique
  redeemedAt DateTime @default(now())
  expiresAt  DateTime
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@index([userId])
  @@index([expiresAt])
}

model Plan {
  id                   String                @id @default(uuid())
  planCode             String                @unique
  displayName          String
  displayNameBg        String?
  priceWeeklyEur       Int?
  priceMonthlyEur      Int?
  priceYearlyEur       Int
  cashbackRate         Float
  stickerBonus         Float                 @default(0)
  features             String?
  featuresBg           String?
  cardType             String                @default("silver")
  isFeatured           Boolean               @default(false)
  badgeText            String?
  badgeTextBg          String?
  displayOrder         Int                   @default(0)
  hasWeeklyOption      Boolean               @default(false)
  hasMonthlyOption     Boolean               @default(true)
  hasYearlyOption      Boolean               @default(true)
  yearlyDiscountPct    Int                   @default(20)
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  pendingSubscriptions PendingSubscription[]
  subscriptions        Subscription[]

  @@index([planCode])
  @@index([isActive])
  @@index([displayOrder])
  @@map("plans")
}

model Transaction {
  id                String             @id @default(uuid())
  userId            String
  partnerId         String?
  venueId           String?
  offerId           String?
  bookingId         String?
  cardId            String?
  type              TransactionType
  status            TransactionStatus
  amount            Float
  discount          Float?
  discountAmount    Float?
  finalAmount       Float?
  currency          String             @default("BGN")
  paymentMethod     PaymentMethod
  paymentIntentId   String?
  stripePaymentId   String?            @unique
  description       String?
  descriptionBg     String?
  metadata          String?
  loyaltyPoints     Int?
  cashbackAmount    Float?
  processingFee     Float?
  netAmount         Float?
  refundedAmount    Float?
  refundedAt        DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  riskScore         Int?
  marginAmount      Float?
  subscriptionId    String?
  receipt           Receipt?
  stickerScan       StickerScan?
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  offer             Offer?             @relation(fields: [offerId], references: [id])
  partner           Partner?           @relation(fields: [partnerId], references: [id])
  subscription      Subscription?      @relation(fields: [subscriptionId], references: [id], onUpdate: NoAction)
  user              User               @relation(fields: [userId], references: [id])
  venue             Venue?             @relation(fields: [venueId], references: [id])
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([subscriptionId])
  @@index([partnerId])
  @@index([venueId])
  @@index([cardId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Wallet {
  id                    String              @id @default(uuid())
  userId                String              @unique
  balance               Float               @default(0.0)
  availableBalance      Float               @default(0.0)
  pendingBalance        Float               @default(0.0)
  currency              String              @default("BGN")
  isLocked              Boolean             @default(false)
  lockedReason          String?
  lockedAt              DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  payoutIban            String?
  payoutBeneficiaryName String?
  transactions          WalletTransaction[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model WalletTransaction {
  id                    String                  @id @default(uuid())
  walletId              String
  type                  WalletTransactionType
  amount                Float
  balanceBefore         Float
  balanceAfter          Float
  currency              String                  @default("BGN")
  status                WalletTransactionStatus @default(PENDING)
  description           String?
  metadata              String?
  transactionId         String?                 @unique
  stripePaymentIntentId String?
  receiptId             String?
  stickerScanId         String?
  createdAt             DateTime                @default(now())
  cashbackExpiresAt     DateTime?
  cashbackPaidAt        DateTime?
  cashbackStatus        CashbackEntryStatus?
  clearedAt             DateTime?
  voidedAt              DateTime?
  voidedByUserId        String?
  voidedReason          String?
  lockedAt              DateTime?
  payoutIbanSnapshot    String?
  receipt               Receipt?                @relation(fields: [receiptId], references: [id])
  stickerScan           StickerScan?            @relation(fields: [stickerScanId], references: [id])
  transaction           Transaction?            @relation(fields: [transactionId], references: [id])
  User                  User?                   @relation(fields: [voidedByUserId], references: [id], onUpdate: NoAction)
  wallet                Wallet                  @relation(fields: [walletId], references: [id])

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([cashbackExpiresAt])
  @@index([stripePaymentIntentId])
  @@index([cashbackStatus])
  @@map("wallet_transactions")
}

model Subscription {
  id                        String             @id @default(uuid())
  userId                    String
  plan                      SubscriptionPlan
  status                    SubscriptionStatus
  stripeSubscriptionId      String?            @unique
  stripePriceId             String?
  stripeCustomerId          String?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  cancelAtPeriodEnd         Boolean            @default(false)
  cancelAt                  DateTime?
  canceledAt                DateTime?
  trialStart                DateTime?
  trialEnd                  DateTime?
  metadata                  String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  payseraOrderId            String?            @unique
  // BC-MYPOS-004: provider-neutral replacement join key. paymentProvider is
  // nullable during the migration window (legacy rows and any consumer not
  // yet updated by BC-MYPOS-005 leave it unset) — NOT NULL is deferred to a
  // follow-up once all writers populate it (see migration header comment).
  paymentProvider           PaymentProvider?
  providerOrderId           String?
  planId                    String?
  autoRenewal               Boolean            @default(true)
