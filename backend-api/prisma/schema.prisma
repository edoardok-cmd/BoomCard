// Spec §4.1 defines four canonical QR Code statuses:
//   Active | Inactive | In Processing | Replaced
//
// PENDING: pre-print/pre-deploy state — maps to "In Processing" for display.
//   Not in the spec enum directly but operationally required before a sticker
//   is sent to print. Mobile and partner UIs should treat PENDING identically
//   to PROCESSING (label: "В обработка").
//
// DAMAGED: NOT in the spec §4.1 enum. Retained for operational tracking of
//   physically damaged labels that have not yet been replaced. Do NOT use in
//   QR-validation or cascade logic — treat as INACTIVE for all operational
//   gates. Any admin workflow that encounters DAMAGED must proceed via
//   replaceSticker() to transition to REPLACED.
//
// RETIRED: NOT in the spec §4.1 enum. Semantically identical to REPLACED —
//   the physical label is no longer in service. All new code MUST use REPLACED.
//   RETIRED is preserved only for backward compatibility with existing rows.
//   Migration note: run the following once to normalise legacy data:
//     UPDATE "Sticker" SET "status" = 'REPLACED' WHERE "status" = 'RETIRED';
//   After that migration, RETIRED can be safely removed from the enum in a
//   subsequent migration.
enum StickerStatus {
  PENDING
  ACTIVE
  INACTIVE
  // Spec §5.4 "В обработка" — sticker ordered/printed but not yet deployed.
  PROCESSING
  // Non-spec operational state. Treat as INACTIVE for all scan/cascade gates.
  // Use replaceSticker() to transition to REPLACED.
  DAMAGED
  // Spec §5.4 "Заменен" — physically replaced by a new sticker; old code
  // retired. Prefer REPLACED for all new writes.
  REPLACED
  // Alias for REPLACED — kept for backward compat with existing rows.
  // Migrate existing RETIRED rows to REPLACED; remove this value afterward.
  RETIRED
}

