// Spec §4.4 v1.1 — entry-based cashback lifecycle. Every WalletTransaction
// of type CASHBACK_CREDIT carries one of these statuses for its 60-day
// rolling window. Voided is the new "rejected at risk review" terminal state
// that stays visible to the user (vs deleting the row).
enum CashbackEntryStatus {
  PENDING // awaiting risk decision or initial clearance
  CLEARED // approved, 60-day rolling validity starts at clearedAt
  LOCKED // included in a pending payout batch
  PAID // payout completed
  EXPIRED // 60-day window elapsed without payout
  VOIDED // risk review rejected — visible to user with reason + audit
}

