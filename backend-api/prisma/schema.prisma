// F-022: Canonical spec values for SubscriptionStatus: Active | Expired | Cancelled | Failed Payment.
// Additional values below are Stripe/operational extensions and are NOT user-facing status labels.
// They exist to support Stripe's subscription lifecycle, Paysera PAUSED state, and internal
// operational states. These must never be displayed directly to users — always map to a
// user-friendly label before surfacing in any API response or notification.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE // Stripe-operational: payment overdue, retrying. Not user-facing.
  CANCELLED
  INCOMPLETE // Stripe-operational: initial payment not yet confirmed. Not user-facing.
  INCOMPLETE_EXPIRED // Stripe-operational: payment window expired. Not user-facing.
  TRIALING // Stripe-operational extension: trial period. Maps to "Active" for users.
  UNPAID // Stripe-operational: all retries exhausted. Not user-facing.
  PAUSED // Operational extension: auto-renew off, grace window. Not user-facing.
  EXPIRED
  // Spec §4.2 v1.1 — single attempt, no retry, no grace period. On entry: scanning
  // blocked, CTA shown in mobile app, payouts gated (§6.1 subscription_gate).
  FAILED_PAYMENT
}

// Spec §4.4 v1.1 — entry-based cashback lifecycle. Every WalletTransaction
// of type CASHBACK_CREDIT carries one of these statuses for its 60-day
// rolling window. Voided is the new "rejected at risk review" terminal state
// that stays visible to the user (vs deleting the row).
enum CashbackEntryStatus {
  PENDING // awaiting risk decision or initial clearance
  TRIAL_PENDING // 24-hour trial window — voided if user cancels within trial (admin audit migration)
  CLEARED // approved, 60-day rolling validity starts at clearedAt
  LOCKED // included in a pending payout batch
  PAID // payout completed
  EXPIRED // 60-day window elapsed without payout
  VOIDED // risk review rejected — visible to user with reason + audit
}

