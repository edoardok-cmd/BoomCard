// BoomCard Partner Dashboard - Prisma Schema
// Database: SQLite (development) / PostgreSQL (production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// User & Authentication Models
// ============================================

enum UserRole {
  USER
  PARTNER
  ADMIN
  SUPER_ADMIN
}

enum RiskBucket {
  LOW_0_30
  REVIEW_31_60
  HIGH_61_PLUS
}

enum AdminRoleKey {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  FINANCE
  RISK_REVIEW
  PARTNER_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  PENDING_PAYMENT // User registered but payment not yet confirmed
  DELETED         // Soft-deleted; deletedAt is always set when this status is used
}

model User {
  id               String     @id @default(uuid())
  email            String
  passwordHash     String
  firstName        String?
  lastName         String?
  phone            String?
  avatar           String?
  role             UserRole   @default(USER)
  status           UserStatus @default(PENDING_VERIFICATION)
  emailVerified    Boolean    @default(false)
  emailVerifiedAt  DateTime?
  lastLoginAt      DateTime?
  stripeCustomerId String?    @unique // Stripe customer ID for payments

  // Email Verification
  emailVerificationToken  String?   @unique
  emailVerificationExpiry DateTime?

  // Password Reset
  passwordResetToken   String?
  passwordResetExpires DateTime?
  // Stamped whenever the passwordHash is rotated (change, reset, delete-anonymize).
  // Used by /auth/switch-account to refuse sibling-pivot attempts from an
  // access token that was issued before the rotation (access tokens are not
  // individually revocable, so we compare against the token's iat).
  passwordChangedAt    DateTime?

  // Soft-delete
  deletedAt        DateTime?

  // Risk scoring (rule-sum; riskScore exposed for future ML)
  riskScore        Int        @default(0)
  riskBucket       RiskBucket?

  // TOTP 2FA
  totpSecret       String?
  totpEnabledAt    DateTime?

  // Finance fields (Phase 4 preview — safe to add now)
  iban             String?
  ibanLastChangedAt DateTime?

  // GDPR Consent Tracking
  termsAcceptedAt    DateTime?
  privacyAcceptedAt  DateTime?
  termsVersion       String?    // e.g. "2026-02-24"
  marketingConsent        Boolean   @default(false)
  marketingConsentAt      DateTime?
  marketingConsentEmail   Boolean   @default(false)
  marketingConsentPhone   Boolean   @default(false)
  marketingConsentEmailAt DateTime?
  marketingConsentPhoneAt DateTime?

  // Language preference — 'bg' (default) or 'en'.
  // Emails are sent in Bulgarian unless the user explicitly switched to English.
  preferredLanguage String @default("bg")

  // Notification channel preferences (email/push/inApp/sms toggles + quiet hours).
  // Shape mirrors NotificationPreferences in partner-dashboard's notifications.service.ts.
  // Stored as JSON to avoid a wide column explosion as preference categories grow.
  notificationPreferences Json?

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  refreshTokens       RefreshToken[]
  partner             Partner?
  transactions        Transaction[]
  receipts            Receipt[]
  receiptUploadTokens ReceiptUploadToken[]
  loyaltyAccount      LoyaltyAccount?
  conversations       ConversationParticipant[]
  messages            Message[]
  notifications       Notification[]
  bookings            Booking[]
  reviews             Review[]
  favorites           Favorite[]
  cards               Card[]
  stickerScans        StickerScan[]
  wallet              Wallet?
  subscriptions       Subscription[]
  offerRedemptions    OfferRedemption[]
  savedPaymentMethods SavedPaymentMethod[]
  pushTokens          PushToken[]
  adminRoles          UserAdminRole[]
  grantedAdminRoles   UserAdminRole[] @relation("GrantedRoles")
  auditLogs           AuditLog[]
  helpTickets         HelpTicket[]    @relation("TicketUser")
  assignedTickets     HelpTicket[]    @relation("TicketAssignee")
  ticketReplies       TicketReply[]   @relation("TicketReplies")
  superAdminRequests  PendingSuperAdminRequest[] @relation("SuperAdminRequester")
  partnerRequestNotes PartnerRequestNote[] @relation("PartnerRequestNoteAuthor")
  loginHistory        LoginHistory[]

  @@unique([email, role], map: "User_email_role_key")
  @@index([email])
  @@index([role])
  @@index([status])
}

// Pending SUPER_ADMIN creation requests — require a second admin to approve.
// Stores the hashed password so the actual User is only created on approval.
model PendingSuperAdminRequest {
  id           String   @id @default(uuid())
  email        String
  firstName    String?
  lastName     String?
  phone        String?
  passwordHash String
  requestedById String
  requestedBy  User     @relation("SuperAdminRequester", fields: [requestedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([email])
  @@index([requestedById])
  @@map("pending_super_admin_requests")
}

model RefreshToken {
  id           String   @id @default(uuid())
  token        String   @unique
  userId       String
  clientType   String?
  // IDs of sibling accounts the same login (same email + same password) also
  // opened. Lets the user freely switch between them without re-auth. Empty
  // array means "no siblings" — the common single-account case.
  accountGroup String[] @default([])
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  // Matches the SQL migration `20260418_refresh_token_account_group_gin`.
  // Required so password rotation / account deletion's `accountGroup: { has: userId }`
  // filter uses the index instead of seq-scanning RefreshToken.
  // `map:` pins the name so `prisma migrate diff` doesn't see drift against
  // the migration's `_gin` suffix (Prisma's default would be `_idx`).
  @@index([accountGroup], type: Gin, map: "RefreshToken_accountGroup_gin")
}

// ============================================
// Partner Models
// ============================================

// Onboarding pipeline statuses — spec 5.1–5.2
// нова → комуникация → договаряне → онбординг → одобрена / отказана
enum PartnerRequestStatus {
  NOVA
  KOMUNIKACIYA
  DOGOVARYANE
  ONBOARDING
  ODOBRENA
  OTKAZANA
}

enum PartnerStatus {
  PENDING
  ACTIVE
  PAUSED     // Temporarily hidden/paused — spec 5.3
  SUSPENDED  // Suspended for policy violation
  ARCHIVED   // Permanently deactivated — spec 5.3 (replaces INACTIVE semantically)
  INACTIVE   // Legacy compat; prefer ARCHIVED for new code
  REJECTED   // Request rejected during onboarding
}

model Partner {
  id             String        @id @default(uuid())
  userId         String        @unique
  businessName   String
  businessNameBg String?
  category       String
  categories     String[]      // All categories; category holds the primary one
  description    String?
  descriptionBg  String?
  logo           String?
  coverImage     String?
  partnerTypeId  String?       // FK → PartnerType (dynamic, replaces hardcoded tier enum)
  discountRate   Float?        // Effective discount % for cardholders. NULL = use partnerType.maxDiscountRate.
  status         PartnerStatus @default(PENDING)
  rating         Float         @default(0)
  reviewCount    Int           @default(0)
  website        String?
  phone          String?
  email          String?
  address        String?
  city           String?
  region         String?
  latitude       Float?
  longitude      Float?
  openingHours   String? // JSON string
  features       String? // JSON string
  amenities      String? // JSON string
  joinedAt       DateTime      @default(now())
  verifiedAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  pendingChanges    Json?
  pendingChangesAt  DateTime?

  // Onboarding pipeline — spec 5.1–5.2
  requestStatus    PartnerRequestStatus?     // null = not yet in pipeline; set on first admin action
  assignedAdminId  String?                   // "Отговорник" — admin assigned to this partner request

  // Visibility — spec 5.3 "Видим или скрит за абонати"
  isVisible        Boolean                   @default(true)

  // Relations
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerType      PartnerType?             @relation(fields: [partnerTypeId], references: [id])
  venues           Venue[]
  offers           Offer[]
  reviews          Review[]
  bookings         Booking[]
  transactions     Transaction[]
  cashbackPayments     PartnerCashbackPayment[]
  marketingListMembers MarketingListMember[]
  requestNotes         PartnerRequestNote[]

  @@index([category])
  @@index([partnerTypeId])
  @@index([status])
  @@index([city])
}

enum CashbackPaymentStatus {
  PENDING
  PAID
  OVERDUE
}

model PartnerCashbackPayment {
  id                String                @id @default(uuid())
  partnerId         String
  month             String                // "YYYY-MM"
  totalCashbackOwed Float                 @default(0) // sum of APPROVED receipt cashbackAmounts
  marginAmount      Float                 @default(0) // BoomCard margin retained — spec 6.2
  paidAt            DateTime?
  paidBy            String?               // admin userId
  notes             String?
  status            CashbackPaymentStatus @default(PENDING)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id])

  @@unique([partnerId, month])
  @@index([status])
  @@index([month])
}

// Communication log for partner onboarding pipeline — spec 5.2
model PartnerRequestNote {
  id         String   @id @default(uuid())
  partnerId  String
  partner    Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("PartnerRequestNoteAuthor", fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(true) // false = visible to partner in future partner portal
  createdAt  DateTime @default(now())

  @@index([partnerId])
  @@index([createdAt])
}

model Venue {
  id            String   @id @default(uuid())
  partnerId     String
  name          String
  nameBg        String?
  address       String
  city          String
  region        String?
  latitude      Float?
  longitude     Float?
  phone         String?
  email         String?
  description   String?
  descriptionBg String?
  images        String? // JSON array
  menuImages    String? // JSON array — legacy; kept for backwards compat
  openingHours  String? // JSON string
  capacity      Int?
  features      String? // JSON array

  menuUrl             String?
  pendingMenuUrl      String?
  menuStatus          MenuStatus @default(NONE)
  menuRejectionReason String?
  menuSubmittedAt     DateTime?
  menuReviewedAt      DateTime?
  menuReviewedBy      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  partner          Partner             @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  transactions     Transaction[]
  stickers         Sticker[]
  stickerLocations StickerLocation[]
  stickerScans     StickerScan[]
  stickerConfig    VenueStickerConfig?

  @@index([partnerId])
  @@index([city])
  @@index([menuStatus])
}

enum MenuStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// Partner Type (replaces hardcoded PartnerTier enum)
// ============================================

model PartnerType {
  id              String   @id @default(uuid())
  name            String   @unique        // e.g. "BASIC", "GOLD", "VIP" — admin-defined
  nameBg          String?
  description     String?
  descriptionBg   String?
  maxDiscountRate Float                   // max % discount partners of this type may publish
  color           String   @default("#6b7280") // hex color for badges
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  partners   Partner[]
  planAccess PlanTypeAccess[]

  @@index([isActive])
  @@index([sortOrder])
}

// Controls which subscription plans can view and/or redeem offers
// from partners of a given type. Replaces hardcoded PLAN_REDEEMABLE_TIERS.
model PlanTypeAccess {
  id            String           @id @default(uuid())
  plan          SubscriptionPlan
  partnerTypeId String
  canView       Boolean          @default(true)
  canRedeem     Boolean          @default(true)

  partnerType PartnerType @relation(fields: [partnerTypeId], references: [id], onDelete: Cascade)

  @@unique([plan, partnerTypeId])
  @@index([plan])
  @@index([partnerTypeId])
}

// ============================================
// Offers & Promotions
// ============================================

enum OfferStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum OfferType {
  DISCOUNT
  CASHBACK
  POINTS
  BUNDLE
  SEASONAL
}

model Offer {
  id                String      @id @default(uuid())
  partnerId         String
  title             String
  titleBg           String?
  description       String
  descriptionBg     String?
  type              OfferType
  discountPercent   Float?
  discountAmount    Float?
  cashbackPercent   Float?
  pointsMultiplier  Float?
  minPurchase       Float?
  maxDiscount       Float?
  termsConditions   String?
  termsConditionsBg String?
  image             String?
  tags              String?     // JSON array of tag strings, e.g. ["spa","wellness"]
  status            OfferStatus @default(DRAFT)
  isFeatured        Boolean     @default(false)
  featuredOrder     Int?
  startDate         DateTime
  endDate           DateTime
  usageLimit        Int?
  usageCount        Int         @default(0)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  partner      Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  redemptions  OfferRedemption[]

  @@index([partnerId])
  @@index([status])
  @@index([isFeatured])
  @@index([startDate])
  @@index([endDate])
  @@index([status, isFeatured, startDate, endDate]) // Active-offer list queries
}

// Tracks each user's redemption of an offer.
// Prevents the same user from redeeming the same offer more than once,
// and persists the one-time code so it can be verified by the partner.
model OfferRedemption {
  id         String   @id @default(uuid())
  offerId    String
  userId     String
  code       String   @unique
  redeemedAt DateTime @default(now())
  expiresAt  DateTime

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId]) // one redemption per user per offer
  @@index([offerId])
  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Transactions & Payments
// ============================================

enum TransactionType {
  BOOKING
  PURCHASE
  WALLET_TOPUP
  REFUND
  LOYALTY_REDEMPTION
  SUBSCRIPTION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  WALLET
  BANK_TRANSFER
  CASH
}

enum WalletTransactionType {
  TOP_UP
  WITHDRAWAL
  CASHBACK_CREDIT
  PURCHASE
  REFUND
  TRANSFER
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  TRIAL_PENDING
  ANNULLED
}

enum SubscriptionPlan {
  LIGHT    // Premium Weekly - €6.99/week, up to 20% cashback, min payout €10
  BASIC    // Basic - €8.99/month, up to 10% cashback, min payout €20
  PREMIUM  // Premium - €13.99/month, up to 20% cashback, min payout €15
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  UNPAID
  PAUSED
}

// ============================================
// Plan Pricing (Source of Truth for Subscriptions)
// ============================================

model Plan {
  id              String  @id @default(uuid())

  // Plan identification
  planCode        String  @unique // LIGHT, BASIC, PREMIUM
  displayName     String           // "Premium Weekly", "Basic", "Premium"
  displayNameBg   String?          // Bulgarian translation

  // Pricing (stored in cents to avoid floating point issues)
  priceWeeklyEur  Int?             // Weekly price in EUR cents (null if not available)
  priceMonthlyEur Int?             // Monthly price in EUR cents (null if not available)
  priceYearlyEur  Int              // Yearly price in EUR cents

  // Features & Benefits
  cashbackRate    Float            // e.g., 0.20 for 20%
  stickerBonus    Float  @default(0) // Additional bonus for sticker scans
  features        String?          // JSON array of feature strings
  featuresBg      String?          // JSON array in Bulgarian

  // Display properties
  cardType        String  @default("silver") // light, silver, black
  isFeatured      Boolean @default(false)
  badgeText       String?          // e.g., "Most Popular", "Best Value"
  badgeTextBg     String?
  displayOrder    Int     @default(0)

  // Billing options
  hasWeeklyOption   Boolean @default(false)
  hasMonthlyOption  Boolean @default(true)
  hasYearlyOption   Boolean @default(true)
  yearlyDiscountPct Int     @default(20) // Discount percentage for yearly

  // Status
  isActive        Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  subscriptions        Subscription[]
  pendingSubscriptions PendingSubscription[]

  @@index([planCode])
  @@index([isActive])
  @@index([displayOrder])
  @@map("plans")
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  partnerId       String?
  venueId         String?
  offerId         String?
  bookingId       String?
  cardId          String?
  type            TransactionType
  status          TransactionStatus
  amount          Float
  discount        Float?
  discountAmount  Float?
  finalAmount     Float?
  currency        String            @default("BGN")
  paymentMethod   PaymentMethod
  paymentIntentId String?
  stripePaymentId String?           @unique
  description     String?
  descriptionBg   String?
  metadata        String? // JSON string
  loyaltyPoints   Int?
  cashbackAmount  Float?
  processingFee   Float?
  netAmount       Float?
  refundedAmount  Float?
  refundedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  partner           Partner?           @relation(fields: [partnerId], references: [id])
  venue             Venue?             @relation(fields: [venueId], references: [id])
  offer             Offer?             @relation(fields: [offerId], references: [id])
  booking           Booking?           @relation(fields: [bookingId], references: [id])
  receipt           Receipt?
  stickerScan       StickerScan?
  walletTransaction WalletTransaction?

  @@index([userId])
  @@index([partnerId])
  @@index([venueId])
  @@index([cardId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// Wallet System
// ============================================

model Wallet {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  balance          Float  @default(0.0)
  availableBalance Float  @default(0.0) // balance - pending withdrawals
  pendingBalance   Float  @default(0.0) // pending cashback credits
  currency         String @default("BGN")

  isLocked     Boolean   @default(false)
  lockedReason String?
  lockedAt     DateTime?

  // Paysera B2C payout destination — stored once, reused on subsequent payouts
  payoutIban            String? // IBAN of the user's bank account
  payoutBeneficiaryName String? // Name as it appears on the bank account

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id       String @id @default(uuid())
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type          WalletTransactionType
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  currency      String                @default("BGN")

  status      WalletTransactionStatus @default(PENDING)
  description String?
  metadata    String? // JSON

  // Cashback expiry: each CASHBACK_CREDIT expires 60 days after approval (cascading)
  cashbackExpiresAt DateTime? // null = non-cashback transaction; non-null = expiry date

  // Link to related records
  transactionId         String?      @unique
  transaction           Transaction? @relation(fields: [transactionId], references: [id])
  stripePaymentIntentId String?
  receiptId             String?
  receipt               Receipt?     @relation(fields: [receiptId], references: [id])
  stickerScanId         String?
  stickerScan           StickerScan? @relation(fields: [stickerScanId], references: [id])

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([cashbackExpiresAt])
  @@index([stripePaymentIntentId]) // TOP_UP idempotency check in handlePaymentSucceeded
  @@map("wallet_transactions")
}

// ============================================
// Subscription System
// ============================================

model Subscription {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  plan   SubscriptionPlan
  status SubscriptionStatus

  // Stripe integration
  stripeSubscriptionId String? @unique
  stripePriceId        String?
  stripeCustomerId     String?

  // Paysera integration
  payseraOrderId       String? @unique // Paysera payment order ID

  // Link to Plan model (source of truth for pricing)
  planId               String?
  planDetails          Plan?   @relation(fields: [planId], references: [id])

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  cancelAtPeriodEnd        Boolean   @default(false)
  cancelAt                 DateTime?
  canceledAt               DateTime?
  trialStart               DateTime?
  trialEnd                 DateTime?

  // Spec FR-004, FR-006, FR-007
  autoRenewal              Boolean   @default(true)
  trialRefundEligibleUntil DateTime?
  trialRefundUsed          Boolean   @default(false)
  retryAttempt             Int       @default(0)
  gracePeriodEndsAt        DateTime?

  metadata String? // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([plan])
  @@index([planId])
  @@index([payseraOrderId])
  @@map("subscriptions")
}

// ============================================
// Saved Payment Methods
// ============================================

model SavedPaymentMethod {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripePaymentMethodId String @unique
  type                  String // "card", "bank_account"

  // Card details (if type = card)
  last4       String?
  brand       String? // "visa", "mastercard", etc.
  expiryMonth Int?
  expiryYear  Int?
  funding     String? // "credit", "debit", "prepaid"

  // Bank account details (if type = bank_account)
  bankName     String?
  accountLast4 String?

  isDefault Boolean @default(false)

  billingDetails String? // JSON
  metadata       String? // JSON

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([isDefault])
  @@map("payment_methods")
}

// ============================================
// Receipt Scanning & OCR with Fraud Detection
// ============================================

enum ReceiptStatus {
  PENDING // Awaiting OCR processing
  PROCESSING // OCR in progress
  VALIDATING // Fraud checks running
  APPROVED // Approved, cashback credited
  REJECTED // Rejected
  MANUAL_REVIEW // Flagged for admin review
  EXPIRED // Too old to process
}

model Receipt {
  id            String  @id @default(uuid())
  userId        String
  transactionId String? @unique
  venueId       String? // Link to venue if applicable
  offerId       String? // Link to offer if applicable
  cardId        String? // Link to user's card

  // Receipt Image
  imageUrl  String? // Optional for test receipts
  imageKey  String? // Storage key (S3/CloudFlare R2)
  imageHash      String? // SHA-256 for duplicate detection
  perceptualHash String? // 60-char dHash hex for visual similarity

  // OCR Extracted Data
  ocrRawText     String? // Full OCR text output
  ocrData        String? // JSON: parsed OCR data
  merchantName   String?
  totalAmount    Float?
  verifiedAmount Float? // Admin-verified amount
  receiptDate    DateTime?
  items          String? // JSON array of ReceiptItem[]

  // Cashback Calculation
  cashbackPercent Float @default(0)
  cashbackAmount  Float @default(0)

  // OCR & Fraud Scores
  ocrConfidence Float    @default(0) // 0-100
  fraudScore    Float    @default(0) // 0-100
  // Native TEXT[] — append with `{ push: 'CODE' }` for atomic array_append.
  // Migration 20260418_fraud_reasons_text_array converted from a JSON-encoded TEXT.
  fraudReasons  String[] @default([])

  // GPS Verification
  latitude  Float?
  longitude Float?

  // Request Metadata
  ipAddress            String?
  userAgent            String?
  deviceFingerprint    String?  // SHA-256 of canonical device JSON
  deviceFingerprintRaw String?  // Raw device JSON for admin inspection
  submissionCount      Int     @default(1)

  // Validation & Admin Review
  status          ReceiptStatus @default(PENDING)
  reviewedBy      String? // Admin user ID
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  // Metadata
  metadata  String? // JSON string for additional data
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([venueId])
  @@index([status])
  @@index([imageHash])
  @@index([perceptualHash])
  @@index([createdAt])
  @@index([merchantName])
  @@index([fraudScore])
  @@index([userId, deviceFingerprint])
  @@index([userId, perceptualHash]) // Fraud perceptual-duplicate check
  @@index([userId, createdAt])      // Rate-limit daily/monthly count queries
}

// ============================================
// Receipt Upload Tokens
// ============================================
// Server-issued single-use tokens that bind an uploaded image to its
// server-computed hash and live-photo result. Used by /api/receipts/v2/submit
// to defeat the client-supplied hash forgery gap (an attacker could otherwise
// upload a real photo, then submit with a forged hash to bypass SHA-256
// uniqueness). /submit must present the token; the server trusts only the
// fields stored here, never the client body.
model ReceiptUploadToken {
  id             String    @id @default(uuid())
  token          String    @unique
  userId         String
  imageHash      String    // SHA-256 computed server-side at /upload
  perceptualHash String?   // dHash, computed server-side
  livePhotoOk    Boolean   @default(true)
  imageUrl       String
  imageKey       String
  createdAt      DateTime  @default(now())
  expiresAt      DateTime  // 1 hour after issue
  consumedAt     DateTime? // single-use guard; set by atomic updateMany at /submit

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ============================================
// Receipt Analytics
// ============================================

model ReceiptAnalytics {
  id     String @id @default(uuid())
  userId String @unique

  // Receipt Counts
  totalReceipts    Int @default(0)
  approvedReceipts Int @default(0)
  rejectedReceipts Int @default(0)
  pendingReceipts  Int @default(0)

  // Financial Totals
  totalCashback        Float @default(0)
  totalSpent           Float @default(0)
  averageReceiptAmount Float @default(0)

  // Insights
  topMerchant     String?
  lastReceiptDate DateTime?
  successRate     Float     @default(0) // Percentage

  // Metadata
  metadata  String? // JSON: monthly trends, merchant breakdown, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Merchant Whitelist/Blacklist
// ============================================

enum WhitelistStatus {
  APPROVED
  BLOCKED
  PENDING
}

model MerchantWhitelist {
  id           String          @id @default(uuid())
  merchantName String          @unique
  nameBg       String?
  taxId        String?
  status       WhitelistStatus @default(APPROVED)

  // Admin Management
  addedBy String? // Admin user ID
  reason  String?

  // Metadata
  metadata  String? // JSON: additional merchant info
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([merchantName])
}

// ============================================
// Venue Fraud Detection Configuration
// ============================================

model VenueFraudConfig {
  id        String  @id @default(uuid())
  venueId   String? @unique
  partnerId String? // Can be global or per-partner

  // Cashback Settings
  cashbackPercent    Float  @default(5.0)
  premiumBonus       Float  @default(2.0)
  platinumBonus      Float  @default(5.0)
  minBillAmount      Float  @default(0)
  maxCashbackPerScan Float?

  // Rate Limiting
  maxScansPerDay   Int @default(999999)
  maxScansPerMonth Int @default(999999)

  // Fraud Detection Settings
  gpsVerificationEnabled Boolean @default(true)
  gpsRadiusMeters        Int     @default(100)
  ocrVerificationEnabled Boolean @default(true)
  autoApproveThreshold   Float   @default(30) // Fraud score threshold
  autoRejectThreshold    Float   @default(60)

  // Template Matching Settings
  templateMatchEnabled      Boolean @default(false)
  templateVisualWeight      Float   @default(0.5)
  templateMerchantWeight    Float   @default(0.3)
  templateKeywordWeight     Float   @default(0.2)
  templateMinSimilarity     Float   @default(0.6)
  templateFraudPoints       Int     @default(20)
  templateMerchantThreshold Float   @default(0.8)

  // Metadata
  isActive  Boolean  @default(true)
  metadata  String? // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([partnerId])
}

// ============================================
// Venue Receipt Templates (admin-uploaded reference receipts for fraud comparison)
// ============================================

model VenueReceiptTemplate {
  id               String  @id @default(uuid())
  venueId          String  // References Partner.id (no FK — matches VenueFraudConfig pattern)
  merchantName     String  // Expected merchant name on valid receipts
  description      String? // Admin note
  expectedKeywords String? // JSON string[] of OCR keywords that should appear
  imageUrl         String  // S3 URL
  imageKey         String  // S3 key (used for deletion)
  perceptualHash   String  // 60-char dHash hex for visual comparison
  isActive         Boolean @default(true)
  uploadedBy       String  // Admin user ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
  @@index([venueId, isActive])
}

// ============================================
// Loyalty & Rewards
// ============================================

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

model LoyaltyAccount {
  id              String      @id @default(uuid())
  userId          String      @unique
  tier            LoyaltyTier @default(BRONZE)
  points          Int         @default(0)
  lifetimePoints  Int         @default(0)
  tierProgress    Float       @default(0)
  cashbackBalance Float       @default(0)
  nextTierPoints  Int?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]
  rewards      RewardRedemption[]
  badges       UserBadge[]

  @@index([userId])
  @@index([tier])
}

enum LoyaltyTransactionType {
  EARNED
  REDEEMED
  EXPIRED
  ADJUSTED
  BONUS
}

model LoyaltyTransaction {
  id            String                 @id @default(uuid())
  accountId     String
  type          LoyaltyTransactionType
  points        Int
  description   String?
  descriptionBg String?
  metadata      String? // JSON string
  expiresAt     DateTime?
  createdAt     DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
}

model Reward {
  id            String    @id @default(uuid())
  title         String
  titleBg       String?
  description   String
  descriptionBg String?
  pointsCost    Int
  cashValue     Float?
  category      String
  image         String?
  isActive      Boolean   @default(true)
  stockQuantity Int?
  redeemedCount Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  redemptions RewardRedemption[]

  @@index([category])
  @@index([isActive])
}

enum RedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  USED
  EXPIRED
}

model RewardRedemption {
  id          String           @id @default(uuid())
  accountId   String
  rewardId    String
  status      RedemptionStatus @default(PENDING)
  pointsSpent Int
  code        String?
  expiresAt   DateTime?
  usedAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  account LoyaltyAccount @relation(fields: [accountId], references: [id])
  reward  Reward         @relation(fields: [rewardId], references: [id])

  @@index([accountId])
  @@index([rewardId])
  @@index([status])
}

model Badge {
  id            String   @id @default(uuid())
  name          String   @unique
  nameBg        String?
  description   String
  descriptionBg String?
  icon          String?
  category      String
  requirement   String // JSON string defining unlock conditions
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  userBadges UserBadge[]

  @@index([category])
}

model UserBadge {
  id         String   @id @default(uuid())
  accountId  String
  badgeId    String
  unlockedAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  badge   Badge          @relation(fields: [badgeId], references: [id])

  @@unique([accountId, badgeId])
  @@index([accountId])
}

// ============================================
// Bookings
// ============================================

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model Booking {
  id                 String        @id @default(uuid())
  userId             String
  partnerId          String
  venueId            String?
  bookingDate        DateTime
  bookingTime        String
  guestCount         Int
  specialRequests    String?
  specialRequestsBg  String?
  status             BookingStatus @default(PENDING)
  confirmationCode   String?       @unique
  notes              String?
  notesInternal      String?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id])
  partner      Partner       @relation(fields: [partnerId], references: [id])
  venue        Venue?        @relation(fields: [venueId], references: [id])
  transactions Transaction[]

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([bookingDate])
}

// ============================================
// Reviews & Ratings
// ============================================

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

model Review {
  id               String       @id @default(uuid())
  userId           String
  partnerId        String
  rating           Int
  title            String?
  comment          String?
  images           String? // JSON array
  status           ReviewStatus @default(PENDING)
  isVerified       Boolean      @default(false)
  helpful          Int          @default(0)
  notHelpful       Int          @default(0)
  adminResponse    String?
  adminRespondedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@index([rating])
}

// ============================================
// Messaging
// ============================================

enum ConversationType {
  DIRECT
  GROUP
  SUPPORT
}

model Conversation {
  id            String           @id @default(uuid())
  type          ConversationType @default(DIRECT)
  title         String?
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isActive       Boolean   @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  SYSTEM
}

model Message {
  id             String      @id @default(uuid())
  conversationId String
  userId         String
  type           MessageType @default(TEXT)
  content        String
  attachments    String? // JSON array
  isEdited       Boolean     @default(false)
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([conversationId])
  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Notifications
// ============================================

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  LOYALTY_POINTS
  REWARD_AVAILABLE
  NEW_MESSAGE
  REVIEW_RECEIVED
  OFFER_EXPIRING
  RECEIPT_APPROVED
  RECEIPT_REJECTED
  RECEIPT_MANUAL_REVIEW
  CASHBACK_CREDITED
  STICKER_SCAN_APPROVED
  FRAUD_ALERT
  SYSTEM
  MARKETING
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  // 'low' | 'medium' | 'high' | 'urgent'. Stored as string to keep parity with the
  // frontend service union without forcing a Prisma enum migration.
  priority  String           @default("medium")
  title     String
  titleBg   String?
  message   String
  messageBg String?
  data      String? // JSON string of arbitrary metadata
  isRead    Boolean          @default(false)
  readAt    DateTime?
  // Soft-archive — keeps the row but hides it from the default "all" list.
  archivedAt        DateTime?
  // Optional deep-link target (e.g. /partner/offers/123) and action button copy.
  actionUrl         String?
  actionText        String?
  actionTextBg      String?
  // Optional thumbnail rendered in the notification card.
  imageUrl          String?
  // Lightweight pointer back to the entity that triggered the notification.
  relatedEntityType String?
  relatedEntityId   String?
  expiresAt         DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([archivedAt])
  @@index([createdAt])
}

// ============================================
// Favorites
// ============================================

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  partnerId String?
  offerId   String?
  venueId   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, partnerId])
  @@index([userId])
}

// ============================================
// BOOM-Sticker Scan System
// ============================================

enum LocationType {
  TABLE
  COUNTER
  BAR
  ENTRANCE
  RECEPTION
  OTHER
}

enum StickerStatus {
  PENDING // Created but not printed
  ACTIVE // Printed and active
  INACTIVE // Temporarily disabled
  DAMAGED // Needs replacement
  RETIRED // Permanently removed
}

enum ScanStatus {
  SESSION_ACTIVE // QR scanned, session open — awaiting receipt upload
  EXPIRED // Session deadline passed without receipt submission
  PENDING // Receipt submitted, waiting for processing
  VALIDATING // OCR processing
  APPROVED // Approved, cashback credited
  REJECTED // Rejected (fraud, invalid, etc.)
  MANUAL_REVIEW // Flagged for manual review
}

enum CardType {
  LIGHT
  BASIC
  PREMIUM
}

enum CardStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELED
}

model Card {
  id         String     @id @default(uuid())
  userId     String
  cardNumber String     @unique
  type       CardType   @default(LIGHT)
  status     CardStatus @default(ACTIVE)
  qrCode     String     // Base64 data URL - too large for unique index
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stickerScans StickerScan[]

  @@index([userId])
  @@index([cardNumber])
}

model Sticker {
  id            String        @id @default(uuid())
  venueId       String
  locationId    String
  stickerId     String        @unique
  qrCode        String        @unique
  locationType  LocationType  @default(TABLE)
  status        StickerStatus @default(ACTIVE)
  printedAt     DateTime?
  activatedAt   DateTime?
  deactivatedAt DateTime?
  totalScans    Int           @default(0)
  lastScannedAt DateTime?
  metadata      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  venue    Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  location StickerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  scans    StickerScan[]

  @@index([venueId])
  @@index([locationId])
  @@index([stickerId])
  @@index([status])
}

model StickerLocation {
  id             String       @id @default(uuid())
  venueId        String
  name           String
  nameBg         String?
  locationType   LocationType @default(TABLE)
  locationNumber String
  isActive       Boolean      @default(true)
  capacity       Int?
  floor          String?
  section        String?
  metadata       String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  stickers Sticker[]

  @@unique([venueId, locationNumber, locationType])
  @@index([venueId])
}

model StickerScan {
  id               String     @id @default(uuid())
  userId           String
  stickerId        String
  venueId          String
  cardId           String
  billAmount       Float      @default(0)
  verifiedAmount   Float?
  cashbackPercent  Float      @default(0)
  cashbackAmount   Float      @default(0)
  sessionStartedAt DateTime?  // Timestamp when the QR was first scanned (session start)
  status           ScanStatus @default(SESSION_ACTIVE)
  latitude        Float?
  longitude       Float?
  distance        Float?
  receiptImageUrl String?
  receiptImageHash String?    @unique  // SHA-256 of the uploaded receipt bytes (Finding #6 — unique-index-enforced dedupe)
  ocrData         String?
  fraudScore      Float      @default(0)
  // Native TEXT[] — append with `{ push: 'CODE' }` for atomic array_append.
  // Migration 20260418_fraud_reasons_text_array converted from a JSON-encoded TEXT.
  fraudReasons    String[]   @default([])
  ipAddress            String?
  userAgent            String?
  deviceFingerprint    String?  // SHA-256 of canonical device JSON
  deviceFingerprintRaw String?  // Raw device JSON for admin inspection
  transactionId   String?    @unique
  rejectionReason String?
  processedAt     DateTime?
  metadata        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user               User                @relation(fields: [userId], references: [id])
  sticker            Sticker             @relation(fields: [stickerId], references: [id])
  venue              Venue               @relation(fields: [venueId], references: [id])
  card               Card                @relation(fields: [cardId], references: [id])
  transaction        Transaction?        @relation(fields: [transactionId], references: [id])
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([stickerId])
  @@index([venueId])
  @@index([cardId])
  @@index([status])
  @@index([createdAt])
  @@index([userId, deviceFingerprint])
}

model VenueStickerConfig {
  id                     String   @id @default(uuid())
  venueId                String   @unique
  cashbackPercent        Float    @default(5.0)
  premiumBonus           Float    @default(2.0)
  platinumBonus          Float    @default(5.0)
  minBillAmount          Float    @default(0)
  maxCashbackPerScan     Float?
  maxScansPerDay         Int      @default(999999)
  maxScansPerMonth       Int      @default(999999)
  gpsVerificationEnabled Boolean  @default(true)
  gpsRadiusMeters        Int      @default(100)
  ocrVerificationEnabled Boolean  @default(true)
  autoApproveThreshold   Float    @default(10)
  isActive               Boolean  @default(true)
  metadata               String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
}

model PushToken {
  id         String   @id @default(uuid())
  userId     String
  token      String   @unique
  platform   String   // ios, android, web
  deviceId   String?
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([isActive])
}

// ============================================
// Cashback Rate Matrix (DB-backed, versioned)
// ============================================

model CashbackRate {
  id           String   @id @default(uuid())
  discountStep Int      // Partner discount % step: 5, 10, 15, 20, or 25
  basic        Float    // User cashback % for BASIC card tier
  premium      Float    // User cashback % for LIGHT/PREMIUM card tiers
  effectiveFrom DateTime @default(now()) // Rates take effect from this timestamp
  createdBy    String?  // Admin user ID who set these rates
  notes        String?  // Optional note (reason for rate change, etc.)
  createdAt    DateTime @default(now())

  @@index([discountStep])
  @@index([effectiveFrom])
  @@map("cashback_rates")
}

// ============================================
// RBAC — Phase 0 Foundations
// ============================================

model Permission {
  id       String @id @default(uuid())
  key      String @unique  // e.g. "subscribers.read", "finance.payouts.write"
  label    String
  category String  // e.g. "subscribers", "finance"

  rolePermissions RolePermission[]
}

model AdminRole {
  id    String       @id @default(uuid())
  key   AdminRoleKey @unique
  label String

  rolePermissions RolePermission[]
  userRoles       UserAdminRole[]
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String
  allow        Boolean @default(true)

  role       AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

model UserAdminRole {
  id          String   @id @default(uuid())
  userId      String
  roleId      String
  grantedById String?
  grantedAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  grantedBy User?     @relation("GrantedRoles", fields: [grantedById], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String   // e.g. "partner.update", "subscriber.delete"
  objectType  String   // e.g. "Partner", "User"
  objectId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([objectType, objectId])
  @@index([createdAt])
}

// ============================================
// System Settings — key/value store for admin-configurable globals
// ============================================
model SystemSetting {
  key         String   @id   // e.g. "cashback_expiry_days", "min_ios_version"
  value       String
  updatedAt   DateTime @updatedAt
  updatedBy   String?          // admin userId

  @@map("system_settings")
}

// ============================================
// Help Tickets — admin support queue
// ============================================

enum TicketStatus {
  NEW
  OPEN
  WAITING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  CASHBACK
  ACCOUNT
  PAYMENT
  TECHNICAL
  OTHER
}

model HelpTicket {
  id         String         @id @default(uuid())
  subject    String
  body       String         @default("")
  category   TicketCategory
  status     TicketStatus   @default(NEW)
  priority   TicketPriority @default(MEDIUM)
  userId     String
  user       User           @relation("TicketUser", fields: [userId], references: [id])
  assigneeId String?
  assignee   User?          @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  replies    TicketReply[]

  @@index([userId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt])
}

model TicketReply {
  id        String     @id @default(uuid())
  ticketId  String
  ticket    HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User       @relation("TicketReplies", fields: [authorId], references: [id])
  body      String
  isAdmin   Boolean    @default(false)
  createdAt DateTime   @default(now())

  @@index([ticketId])
}

// ============================================
// Marketing — templates, campaigns, lists, automations
// ============================================

enum MarketingChannel {
  EMAIL
  PUSH
  SMS
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  PAUSED
}

enum AutomationStatus {
  ACTIVE
  PAUSED
  DRAFT
}

enum MarketingListType {
  STATIC
  DYNAMIC
  SEGMENT
}

model MarketingTemplate {
  id          String                @id @default(uuid())
  name        String
  type        MarketingChannel
  subject     String?
  body        String                @default("")
  usageCount  Int                   @default(0)
  lastUsed    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  campaigns   MarketingCampaign[]
  automations MarketingAutomation[]

  @@index([type])
  @@index([createdAt])
}

model MarketingList {
  id          String            @id @default(uuid())
  name        String
  type        MarketingListType
  description String            @default("")
  size        Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  campaigns   MarketingCampaign[]
  members     MarketingListMember[]

  @@index([type])
  @@index([createdAt])
}

model MarketingCampaign {
  id         String             @id @default(uuid())
  name       String
  type       MarketingChannel
  status     CampaignStatus     @default(DRAFT)
  audience   Int                @default(0)
  sentAt     DateTime?
  openRate   Float?
  clickRate  Float?
  templateId String?
  template   MarketingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  listId     String?
  list       MarketingList?     @relation(fields: [listId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([type])
  @@index([listId])
  @@index([createdAt])
}

model MarketingListMember {
  id        String        @id @default(uuid())
  listId    String
  list      MarketingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  partnerId String
  partner   Partner       @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  addedAt   DateTime      @default(now())

  @@unique([listId, partnerId])
  @@index([listId])
  @@index([partnerId])
}

model MarketingAutomation {
  id         String             @id @default(uuid())
  name       String
  trigger    String
  status     AutomationStatus   @default(DRAFT)
  totalRuns  Int                @default(0)
  lastRunAt  DateTime?
  templateId String?
  template   MarketingTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ============================================
// Pending Subscription (anonymous checkout — T9 prerequisite)
// ============================================

enum PendingSubscriptionStatus {
  CREATED
  PAID
  COMPLETED
  EXPIRED
  FAILED
}

model PendingSubscription {
  id             String                    @id @default(cuid())
  email          String                    // checkout-captured email for receipt + failure notification
  planId         String
  plan           Plan                      @relation(fields: [planId], references: [id])
  payseraOrderId String?                   @unique
  status         PendingSubscriptionStatus @default(CREATED)
  token          String?                   @unique // one-time profile-completion token (set on PAID)
  tokenExpiresAt DateTime?                 // ~30 min TTL
  billingPeriod  String?                   // 'weekly' | 'monthly' | 'yearly' — stored at checkout initiation
  paidAt         DateTime?
  completedAt    DateTime?                 // set when POST /auth/complete-profile consumes token
  createdAt      DateTime                  @default(now())
  expiresAt      DateTime                  // hard expiry for cleanup job (~24h from creation)

  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

// ============================================
// Login History — spec section 12 "Профил > Сигурност"
// ============================================

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  success    Boolean
  failReason String?  // e.g. "bad_password", "totp_required", "totp_invalid"
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ============================================
// Finance Reporting Period lifecycle — spec 6.3
// Отворен → За проверка → Заключен → Фактуриран
// ============================================

enum ReportingPeriodStatus {
  OPEN       // Default; cashback payments can be created/edited
  FOR_REVIEW // Submitted for finance team review
  LOCKED     // No data changes allowed for this month
  INVOICED   // Invoice issued to partners
}

model ReportingPeriod {
  id         String                @id @default(uuid())
  month      String                @unique // "YYYY-MM"
  status     ReportingPeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedBy   String?               // admin userId
  invoicedAt DateTime?
  invoicedBy String?               // admin userId
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([status])
  @@index([month])
}

// ============================================
// Fraud Rules — spec 7.4 per-rule limits management
// ============================================

enum FraudRuleTier {
  SYSTEM       // Global default (replaces system settings scalars)
  PARTNER_TYPE // Applies to all partners of a given type
  PARTNER      // Applies to one specific partner
  USER         // Applies to one specific user
}

model FraudRule {
  id                   String        @id @default(uuid())
  tier                 FraudRuleTier
  targetId             String?       // partnerTypeId / partnerId / userId; null for SYSTEM tier
  dailyScanLimit       Int?
  minTransactionValue  Float?
  maxTransactionValue  Float?
  autoApproveThreshold Float?        // fraud score below which receipts auto-approve
  isActive             Boolean       @default(true)
  notes                String?
  createdBy            String        // admin userId
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  overrides FraudRuleOverride[]

  @@index([tier])
  @@index([targetId])
  @@index([isActive])
}

// Manual override applied to a specific user or partner on top of a FraudRule
model FraudRuleOverride {
  id         String    @id @default(uuid())
  ruleId     String
  rule       FraudRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  targetType String    // "user" | "partner"
  targetId   String
  override   Json      // fields being overridden, e.g. { "dailyScanLimit": 5 }
  reason     String?
  createdBy  String    // admin userId
  expiresAt  DateTime? // optional auto-expiry
  createdAt  DateTime  @default(now())

  @@index([ruleId])
  @@index([targetType, targetId])
}
