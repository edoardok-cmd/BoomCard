// F-022: Canonical spec values for UserAccountStatus: Active | Inactive.
// Additional values below are operational extensions and are NOT spec-canonical user-facing labels.
// SUSPENDED, PENDING_VERIFICATION, PENDING_PAYMENT, DELETED, ARCHIVED are internal/operational
// states used by the authentication and onboarding lifecycle.
// These must never be displayed directly to users as account status labels.
enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED // Operational extension: admin abuse lockout. Blocks login entirely (stricter than spec Inactive). Do NOT use to implement spec-Inactive behavior.
  PENDING_VERIFICATION // Operational: email not yet verified. Not a canonical spec state.
  PENDING_PAYMENT // Operational: awaiting initial payment. Not a canonical spec state.
  DELETED // Operational: soft-delete. Not a canonical spec state.
