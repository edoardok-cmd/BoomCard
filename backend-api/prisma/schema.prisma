model TicketReply {
  id           String     @id @default(uuid())
  ticketId     String
  authorId     String?
  body         String
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  channel      String     @default("WEB")
  externalFrom String?
  inReplyTo    String?
  isAutoReply  Boolean    @default(false)
  messageId    String?    @unique
  author       User?      @relation("TicketReplies", fields: [authorId], references: [id])
  ticket       HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([inReplyTo])
}

model TicketCC {
  id        String     @id @default(uuid())
  ticketId  String
  email     String
  createdAt DateTime   @default(now())
  ticket    HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, email])
  @@index([ticketId])
}

model MarketingTemplate {
  id          String                @id @default(uuid())
  name        String
  type        MarketingChannel
  subject     String?
  body        String                @default("")
  usageCount  Int                   @default(0)
  lastUsed    DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  category    String?
  bodyEn      String?
  subjectEn   String?
  automations MarketingAutomation[]
  campaigns   MarketingCampaign[]

  @@index([type])
  @@index([createdAt])
}

model MarketingList {
  id          String                @id @default(uuid())
  name        String
  type        MarketingListType
  description String                @default("")
  size        Int                   @default(0)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  syncKey     String?               @unique
  campaigns   MarketingCampaign[]
  members     MarketingListMember[]

  @@index([type])
  @@index([createdAt])
}

model MarketingCampaign {
  id          String             @id @default(uuid())
  name        String
  type        MarketingChannel
  status      CampaignStatus     @default(DRAFT)
  audience    Int                @default(0)
  sentAt      DateTime?
  openRate    Float?
  clickRate   Float?
  templateId  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  listId      String?
  scheduledAt DateTime?
  list        MarketingList?     @relation(fields: [listId], references: [id], onDelete: Restrict)
  template    MarketingTemplate? @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([type])
  @@index([listId])
  @@index([createdAt])
}

model MarketingListMember {
  id         String        @id @default(uuid())
  listId     String
  partnerId  String?
  addedAt    DateTime      @default(now())
  memberType String        @default("PARTNER")
  userId     String?
  list       MarketingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  partner    Partner?      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([listId, partnerId])
  @@unique([listId, userId])
  @@index([listId])
  @@index([partnerId])
  @@index([userId])
}

model MarketingAutomation {
  id         String             @id @default(uuid())
  name       String
  trigger    String             @unique
  status     AutomationStatus   @default(DRAFT)
  totalRuns  Int                @default(0)
  lastRunAt  DateTime?
  templateId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  template   MarketingTemplate? @relation(fields: [templateId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model PendingSubscription {
  id              String                    @id @default(cuid())
  email           String
  planId          String
  payseraOrderId  String?                   @unique
  // BC-MYPOS-004: provider-neutral replacement join key, same rationale as
  // Subscription above — nullable until all writers/BC-MYPOS-005 populate it.
  paymentProvider PaymentProvider?
  providerOrderId String?
  status          PendingSubscriptionStatus @default(CREATED)
  token           String?                   @unique
  tokenExpiresAt  DateTime?
  paidAt          DateTime?
  completedAt     DateTime?
  createdAt       DateTime                  @default(now())
  expiresAt       DateTime
  billingPeriod   String?
  language        String?
  plan            Plan                      @relation(fields: [planId], references: [id])

  @@unique([paymentProvider, providerOrderId], name: "PendingSubscription_paymentProvider_providerOrderId_key")
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model LoginHistory {
  id         String   @id @default(uuid())
  userId     String
  ip         String?
  userAgent  String?
  success    Boolean
  failReason String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ReportingPeriod {
  id         String                @id @default(uuid())
  month      String                @unique
  status     ReportingPeriodStatus @default(OPEN)
  lockedAt   DateTime?
  lockedBy   String?
  invoicedAt DateTime?
  invoicedBy String?
  notes      String?
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  reviewedAt DateTime?
  reviewedBy String?
  openedAt   DateTime?
  openedBy   String?

  @@index([status])
  @@index([month])
}

model FraudRule {
  id                   String              @id @default(uuid())
  tier                 FraudRuleTier
  targetId             String?
  dailyScanLimit       Int?
  minTransactionValue  Float?
  maxTransactionValue  Float?
  autoApproveThreshold Float?
  isActive             Boolean             @default(true)
  notes                String?
  createdBy            String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  overrides            FraudRuleOverride[]

  @@index([tier])
  @@index([targetId])
  @@index([isActive])
}

model FraudRuleOverride {
  id         String    @id @default(uuid())
  ruleId     String
  targetType String
  targetId   String
  override   Json
  reason     String?
  createdBy  String
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  rule       FraudRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([targetType, targetId])
}

model MobileErrorLog {
  id         String   @id @default(uuid())
  platform   String
  appVersion String?
  errorType  String
  message    String
  stack      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([platform])
  @@map("mobile_error_logs")
}

/// Spec §11.1 — inbound emails that arrive when no system admin exists yet
/// (fresh install) are persisted here instead of being dropped. A follow-up job
/// can replay them once an admin is provisioned.
model OrphanInboundEmail {
  id               String    @id @default(uuid())
  fromEmail        String
  fromName         String?
  subject          String?
  bodyText         String?
  bodyHtml         String?
  messageId        String?
  rawPayload       Json?
  reason           String    @default("NO_ADMIN")
  replayedAt       DateTime?
  replayedTicketId String?
  createdAt        DateTime  @default(now())

  @@index([createdAt])
  @@index([replayedAt])
}

/// Spec §G7 — inbound bounces (delivery failures, auto-replies, OOO that match
/// no open ticket). Persisted for alerting and audit; not surfaced in the
/// ticket UI unless the operator queries directly.
model InboundBounce {
  id        String   @id @default(uuid())
  fromEmail String
  toEmail   String?
  subject   String?
  messageId String?
  ticketId  String?
  alerted   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([fromEmail])
  @@index([ticketId])
  @@index([createdAt])
}

model ConnectedIntegration {
  id            String   @id @default(uuid())
  partnerId     String
  integrationId String
  status        String   @default("active")
  credentials   String?
  settings      Json?
  connectedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
  partner       Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, integrationId])
  @@index([partnerId])
  @@map("connected_integrations")
}

model PartnerApplication {
  id                 String                   @id
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime
  firstName          String
  lastName           String
  email              String
  phone              String
  businessName       String
  categoryIds        String[]                 @default([])
  city               String
  address            String
  venueCount         Int
  participationLevel String
  additionalText     String?
  termsConsent       Boolean                  @default(false)
  privacyConsent     Boolean                  @default(false)
  marketingConsent   Boolean                  @default(false)
  status             PartnerApplicationStatus @default(NEW)
  assignedAdminId    String?
  internalNotes      String?
  history            Json?
  partnerId          String?                  @unique
  User               User?                    @relation(fields: [assignedAdminId], references: [id])
  Partner            Partner?                 @relation(fields: [partnerId], references: [id])

  @@index([assignedAdminId])
  @@index([createdAt])
  @@index([email])
  @@index([status])
}

model ReviewVote {
  id        String   @id
  reviewId  String
  userId    String
  helpful   Boolean
  createdAt DateTime @default(now())
  Review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([reviewId])
}

