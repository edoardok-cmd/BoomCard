// Spec §11 v1.1 — unified ticketing system. `requestType` separates
// support from change requests (single inbox, filterable). `source`
// records ingress channel ("WEB" / "EMAIL"). `externalEmail` captures
// the original sender when ingested via email gateway (§11.2).
model HelpTicket {
  id             String            @id @default(uuid())
  subject        String
  body           String            @default("")
  category       TicketCategory
  // Spec §11.4: initial status is OPEN. NEW is kept in the enum for existing
  // rows only — no new ticket should arrive with NEW; this default ensures any
  // caller that omits status still lands in the correct initial state.
  status         TicketStatus      @default(OPEN)
  priority       TicketPriority    @default(MEDIUM)
  userId         String
  assigneeId     String?
  // Spec §12.1 Rule 6 — partner tickets must be scoped to the submitting partner
  // so cross-partner ticket access is prevented at the DB level, not only via
  // userId filtering. Nullable because user-submitted (non-partner) tickets have
  // no partnerId. SetNull on delete so the audit record survives partner removal.
  // Populate for all tickets created via partner-facing paths.
  partnerId      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // Spec §10.4 — canonical Request Type Enum: Support | Dispute | Change | Other.
  // Extended with DATA_CHANGE, LOCATION_CHANGE, CONTRACT_CHANGE for operational
  // sub-categories of "Change". All values are enforced at the DB layer via the
  // TicketRequestType enum; application code in shared/ticketing.ts must import
  // and use the enum constants, not raw strings.
  requestType    TicketRequestType @default(SUPPORT)
  // Spec §11.1 ingress channel.
  source         String            @default("WEB") // "WEB" | "EMAIL"
  // Spec §11.2 — original sender email for tickets created from an inbound
  // email (auto-parse). Used to validate reply spoofing and to send auto-reply.
  externalEmail  String?
  // RFC 5322 Message-ID of the inbound email that created this ticket.
  // Used by parser for In-Reply-To / References fallback matching.
  // NOTE: enforced via raw SQL migration 20260629000001 — partial unique index
  //   CREATE UNIQUE INDEX "HelpTicket_rootMessageId_unique" ON "HelpTicket"("rootMessageId") WHERE "rootMessageId" IS NOT NULL
  // This prevents duplicate ticket creation on provider redeliveries (TOCTOU race).
  rootMessageId  String?
  // Auto re-open watermark (§11.4): when an inbound reply hits a CLOSED ticket
  // we re-open and stamp this for the audit log.
  reopenedAt     DateTime?
  // Set when status transitions to RESOLVED so auto-close uses a stable
  // timestamp rather than updatedAt (which bumps on any field change).
  resolvedAt     DateTime?
  linkedTicketId String?
  // Gap 8 fix: 8-char hex short-ref (first 8 hex chars of UUID, dashes stripped).
  // Stored for O(1) subject-prefix lookup instead of the previous 200-ticket scan.
  // Populated on creation by all ticket creation paths.
  shortRef       String?           @unique
  assignee       User?             @relation("TicketAssignee", fields: [assigneeId], references: [id])
  user           User              @relation("TicketUser", fields: [userId], references: [id])
  partner        Partner?          @relation("PartnerHelpTickets", fields: [partnerId], references: [id], onDelete: SetNull)
  linkedTicket   HelpTicket?       @relation("TicketLink", fields: [linkedTicketId], references: [id])
  linkingTickets HelpTicket[]      @relation("TicketLink")
  disputes       Dispute[]         @relation("DisputeTicket")
  replies        TicketReply[]
  ccs            TicketCC[]

  @@index([userId])
  @@index([assigneeId])
  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@index([requestType])
  @@index([source])
  @@index([rootMessageId])
}

model TicketReply {
  id           String     @id @default(uuid())
  ticketId     String
  authorId     String?
  body         String
  isAdmin      Boolean    @default(false)
  createdAt    DateTime   @default(now())
  // Spec §11.2 — RFC 5322 threading headers. messageId is the unique ID of
  // this message (outbound: generated by us; inbound: from the email).
  // inReplyTo is the immediate parent. The parser uses these for thread match.
  messageId    String?    @unique
  inReplyTo    String?
  // Ingress channel of this reply message:
  //   "WEB"      — authored in the admin/partner/user web UI
  //   "EMAIL"    — arrived via the inbound email gateway (ticketInbound.service)
  //   "INTERNAL" — system-generated note (e.g. rejection reason, audit marker);
  //                not shown to end-users, visible only in admin thread view
  channel      String     @default("WEB")
  // Auto-replies and out-of-office headers — see §11.2 edge cases. Surfaced
  // as a metadata-only note in the thread (no reply created).
  isAutoReply  Boolean    @default(false)
  externalFrom String? // sender email when source="EMAIL"
  author       User?      @relation("TicketReplies", fields: [authorId], references: [id])
  ticket       HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([inReplyTo])
}

// Spec §11.2 — CC'd admins ("cc-нати админи") recorded per ticket so that an
// inbound reply from a CC'd address threads into the original ticket instead of
// being treated as a spoofer. A join table is used for per-row provenance
// (createdAt) and to support multiple CCs per ticket. Email is stored lowercased
// and compared case-insensitively by the inbound spoof check.
model TicketCC {
  id        String     @id @default(uuid())
  ticketId  String
  email     String // stored lowercased
  createdAt DateTime   @default(now())
  ticket    HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, email])
  @@index([ticketId])
}

