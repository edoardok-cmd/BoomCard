// Spec §10.4 defines request_status as: New | In Progress | Waiting | Closed | Cancelled.
// This schema extends the spec with additional operational states. Mapping:
//
//   NEW        → spec "New"         — legacy value for existing rows only; no new tickets arrive
//                                     with NEW (default is OPEN). Treat as "New" in display.
//   OPEN       → spec "New"         — initial state for all new tickets; partner-visible label "Нова"
//   IN_REVIEW  → spec "In Progress" — assigned to an admin, actively being worked; partner-visible
//                                     label "В преглед". NOT a partner-visible distinct status;
//                                     map to "In Progress" in partner API responses.
//   WAITING    → spec "Waiting"     — awaiting user/partner response; partner-visible label "Изчакване"
//   RESOLVED   → admin-internal     — admin has resolved; NOT shown to partners as a distinct status.
//                                     Shown as "Closed" in partner API responses. Auto-closes after
//                                     the defined inactivity window (spec §11.4).
//   CLOSED     → spec "Closed"      — confirmed closed; partner-visible label "Затворена"
//   REJECTED   → NOT in spec enum.  — admin declined the request with a reason. Admin-internal;
//                                     partner-visible label "Отказана" (spec §11.4). Map to "Closed"
//                                     in partner API responses unless the portal shows a rejection label.
//   CANCELLED  → spec "Cancelled"   — user or admin cancelled before resolution; partner-visible "Отменена"
//
// Note: RESOLVED and IN_REVIEW are admin-internal operational states. Partner-facing serializers
// MUST NOT expose them as distinct values — map both to the nearest spec-canonical label.
enum TicketStatus {
  NEW
  OPEN
  // Spec §11.4 — "В преглед": ticket has been assigned to an admin and is
  // actively being worked. Distinct from OPEN (received + first contact made
  // but not necessarily owned). Maps to spec "In Progress" in partner responses.
  IN_REVIEW
  WAITING
  // Admin-internal pre-close state. Maps to spec "Closed" in partner responses.
  RESOLVED
  CLOSED
  // Spec §11.4 — "Отказана": admin declined the request with a reason.
  // Terminal state, distinct from CLOSED (which means resolved+confirmed).
  // Not in spec canonical enum — map to "Closed" in partner API responses.
  REJECTED
  // Terminal — user or admin cancelled the ticket before resolution.
  CANCELLED
}

