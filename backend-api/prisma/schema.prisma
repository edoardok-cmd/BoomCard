// Spec §7.2 defines the monthly reporting period cycle as:
//   Open → Under Review → Closed → Invoiced
//
// Mapping from DB values to spec-canonical display labels:
//   OPEN       → "Open"          (spec: Open)
//   FOR_REVIEW → "Under Review"  (spec: Under Review — renamed to FOR_REVIEW
//                                  internally to avoid a SQL reserved-word collision)
//   LOCKED     → "Closed"        (spec: Closed — the edit-lock semantics of LOCKED
//                                  map to the spec's "Closed" terminal state before
//                                  invoicing. Any code checking for the "Closed" phase
//                                  MUST use LOCKED, not a literal 'CLOSED' string.)
//   INVOICED   → "Invoiced"      (spec: Invoiced)
//
// Note: no CLOSED value exists in this enum. The spec's "Closed" state is
// represented by LOCKED. Do NOT add a separate CLOSED value.
enum ReportingPeriodStatus {
  OPEN
  FOR_REVIEW
  LOCKED
  INVOICED
}

