{
  "name": "boomcard-backend-api",
  "version": "1.0.0",
  "description": "BoomCard Backend API Server with Phase 5 Features",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "build": "prisma generate && (tsc || true)",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "deploy": "prisma migrate deploy && npm run start",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "db:studio": "prisma studio",
    "migrate:export": "ts-node scripts/migrate-sqlite-to-postgres.ts",
    "migrate:import": "ts-node scripts/import-postgres-data.ts",
    "migrate:full": "npm run migrate:export && npm run migrate:import",
    "job:reminders": "npx tsx src/jobs/pending-payment-reminders.ts",
    "postinstall": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:baseline": "prisma migrate resolve --applied 0_init",
    "load-test": "k6 run tests/load/k6-load-test.js",
    "load-test:local": "k6 run -e BASE_URL=http://localhost:3001 tests/load/k6-load-test.js",
    "health-check": "curl -sf http://localhost:3001/health | node -e \"process.stdin.on('data',d=>{const h=JSON.parse(d);console.log(h.status==='ok'?'OK':'FAIL',h);process.exit(h.status==='ok'?0:1)})\"",
    "pm2:start": "pm2 start ecosystem.config.js --only boomcard-api --env production",
    "pm2:stop": "pm2 stop boomcard-api",
    "pm2:restart": "pm2 reload boomcard-api",
    "pm2:logs": "pm2 logs boomcard-api",
    "pm2:status": "pm2 status"
  },
  "keywords": [
    "boomcard",
    "api",
    "payments",
    "loyalty",
    "messaging"
  ],
  "author": "BoomCard Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@aws-sdk/s3-request-presigner": "^3.922.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@sentry/node": "^7.109.0",
    "@sentry/profiling-node": "^7.109.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/stripe": "^8.0.416",
    "axios": "^1.6.5",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.74.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exifr": "^7.1.3",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "fast-xml-parser": "^5.2.5",
    "file-type": "^16.5.4",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "otplib": "^13.4.0",
    "pg": "^8.11.3",
    "prisma": "^7.7.0",
    "qrcode": "^1.5.3",
    "redis": "^4.6.11",
    "resend": "^6.4.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "stripe": "^14.25.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "source-map-support": "^0.5.13",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0"
  }
}
