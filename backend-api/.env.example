# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/boomcard
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway - Paysera Checkout (C2B)
PAYSERA_PROJECT_ID=your_paysera_project_id
PAYSERA_SIGN_PASSWORD=your_paysera_sign_password
PAYSERA_TEST_MODE=true
PAYSERA_API_URL=https://www.paysera.com/pay

# Paysera Transfer API (B2C payouts — separate credentials from Checkout)
# Obtain from Paysera developer portal: https://developers.paysera.com/en/transfer
PAYSERA_TRANSFER_CLIENT_ID=your_transfer_client_id
PAYSERA_TRANSFER_MAC_KEY=your_transfer_mac_key
PAYSERA_ACCOUNT_NUMBER=EVPxxxxxxxxxxx  # Your Paysera business account number

# URLs (for payment redirects and callbacks)
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@boomcard.bg
EMAIL_FROM_NAME=BoomCard

# WebSocket
WS_PORT=4000

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# SMS (optional - Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Feature Flags
ENABLE_PAYMENTS=true
ENABLE_LOYALTY=true
ENABLE_MESSAGING=true
ENABLE_ANALYTICS=true

# Web Push (VAPID)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: URL or a https://URL identifying the push sender
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@boomcard.bg
