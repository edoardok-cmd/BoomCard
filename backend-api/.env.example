# Server Configuration
PORT=3025
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/boomcard
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateway - Paysera Checkout (C2B)
# REQUIRED. With NODE_ENV=production the API refuses to start if either
# PAYSERA_PROJECT_ID or PAYSERA_SIGN_PASSWORD is missing or empty: an empty
# signing password reduces the ss1 callback check to md5(data), which any
# anonymous caller can forge. In development/test a missing value only warns.
PAYSERA_PROJECT_ID=your_paysera_project_id
PAYSERA_SIGN_PASSWORD=your_paysera_sign_password
PAYSERA_TEST_MODE=true
PAYSERA_API_URL=https://www.paysera.com/pay

# --- Paysera callback RSA signature (ss2/ss3) verification -------------------
# Paysera signs callbacks a second time with its OWN private key: ss2 is
# RSA/SHA-1 and ss3 is RSA/SHA-256 over the raw `data` string, each URL-safe-
# base64 encoded. They are verified against Paysera's published public key
# (https://www.paysera.com/download/public.key), which ships in the repo at
# backend-api/src/services/paysera-public-key.ts — so no key needs configuring
# for the default path to work, and no network call sits on the callback path.
#
# Override the key only when Paysera rotates it (or to point at the sandbox
# key). Inline PEM wins over the file path; both accept an X.509 certificate
# PEM or a bare "BEGIN PUBLIC KEY" PEM. A public key is not a secret.
# PAYSERA_PUBLIC_KEY=
# PAYSERA_PUBLIC_KEY_PATH=/etc/boomcard/paysera-public.key
#
# PAYSERA_SS2_MODE controls how hard the RSA signature is enforced. ss1 stays an
# unconditional hard gate in every mode.
#   enforce  (default) if the callback carries ss2/ss3 it must verify; if it
#            carries neither, ss1 alone is accepted (Paysera only sends the RSA
#            signature for projects with OpenSSL signing enabled).
#   require  reject any callback without a verifiable ss2/ss3 signature.
#            Genuinely selectable (BC-QA-031-FOLLOWUP-8): every callback route
#            forwards both ss2 and ss3 to the verifier — whichever field(s)
#            your Paysera project actually signs with are checked, and ss3
#            (RSA/SHA-256) is preferred over ss2 (RSA/SHA-1) when both are
#            present, matching Paysera's own lib-webtopay precedence.
#            POST /api/payments/verify-redirect (the guest-checkout success
#            page) is exempt from this mode — Paysera's redirect querystring
#            only ever carries data+ss1, never ss2/ss3, so this endpoint could
#            never satisfy `require` and does not need to. ss1 stays an
#            unconditional hard gate in every mode either way. Enable this
#            once your Paysera project has OpenSSL callback signing turned on
#            and you want a callback that matches ss1 (the shared signing
#            password) but carries no RSA signature at all to be rejected too,
#            rather than accepted on ss1 alone as `enforce` does.
#   off      break-glass during a Paysera key rotation: skip the RSA check and
#            fall back to ss1 only. Re-provision a key and unset immediately.
# PAYSERA_SS2_MODE=enforce

# Paysera Transfer API (B2C payouts — separate credentials from Checkout)
# Obtain from Paysera developer portal: https://developers.paysera.com/en/transfer
PAYSERA_TRANSFER_CLIENT_ID=your_transfer_client_id
PAYSERA_TRANSFER_MAC_KEY=your_transfer_mac_key
PAYSERA_ACCOUNT_NUMBER=EVPxxxxxxxxxxx  # Your Paysera business account number

# URLs (for payment redirects and callbacks, email deep-links)
# In production, set FRONTEND_URL to the customer-facing dashboard origin (e.g. https://boomcard.bg)
FRONTEND_URL=http://localhost:3021
API_BASE_URL=http://localhost:3025

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@boomcard.bg
EMAIL_FROM_NAME=BoomCard

# WebSocket
WS_PORT=4000

# CORS
CORS_ORIGIN=http://localhost:3021

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password

# SMS (optional - Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# Twilio Verify Service SID for phone OTP
TWILIO_VERIFY_SERVICE_SID=

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Feature Flags
ENABLE_PAYMENTS=true
ENABLE_LOYALTY=true
ENABLE_MESSAGING=true
ENABLE_ANALYTICS=true

# Web Push (VAPID)
# Generate with: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_SUBJECT must be a mailto: URL or a https://URL identifying the push sender
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:office@boomcard.bg

# Partner Integration Credentials Encryption
# AES-256-GCM key for encrypting partner integration credentials at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be exactly 64 hex characters (32 bytes).
INTEGRATION_CREDENTIALS_KEY=
