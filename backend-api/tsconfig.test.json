    "tests/integration/impersonation.test.ts",
    "tests/integration/redemption-cross-scope-sweep.test.ts",
    "tests/integration/stickers-permission-gating.test.ts",
    "tests/integration/user-acl-matrix-sweep.test.ts",
    "tests/partner-lifecycle-fixes.test.ts",
    "tests/unit/adminPayoutsBulkApprove.test.ts",
    "tests/unit/auth.deletedGuards.test.ts",
    "tests/unit/bc-admin-audit-fix-002.test.ts",
    "tests/unit/section5.coverage.test.ts",
