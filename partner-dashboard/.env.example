# BoomCard Partner Dashboard - Environment Configuration
# Copy this file to .env.local and fill in your actual values

# ===========================================
# Application Configuration
# ===========================================
NODE_ENV=development
VITE_APP_NAME=BoomCard
VITE_APP_VERSION=2.0.0
VITE_APP_ENVIRONMENT=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3025/api
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:3025
VITE_WS_RECONNECT_ATTEMPTS=5
VITE_WS_RECONNECT_DELAY=3000

# ===========================================
# Authentication
# ===========================================
VITE_JWT_EXPIRES_IN=15m
VITE_REFRESH_TOKEN_EXPIRES_IN=7d

# ===========================================
# Payment Gateways
# ===========================================

# Stripe (public key only — secret key belongs in backend)
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# ===========================================
# Error Tracking & Monitoring
# ===========================================
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0

# ===========================================
# Analytics
# ===========================================
VITE_GA_TRACKING_ID=
VITE_GTM_ID=

# ===========================================
# Maps & Location
# ===========================================
VITE_GOOGLE_MAPS_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# ===========================================
# Feature Flags
# ===========================================
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHAT_SUPPORT=true
VITE_ENABLE_PWA=true
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_DEBUG_MODE=true

# Offer management — UNSPECIFIED FEATURE (spec §8a)
# This flag unlocks the partner-facing offer creation/editing UI (CreateOfferPage,
# EditOfferPage, MyOffersPage).  The backend POST /api/offers endpoint is currently
# authorize('ADMIN','SUPER_ADMIN') only — enabling this flag in any environment while
# that restriction is in place will cause every partner submission to silently fail
# with HTTP 403.  Do NOT set to true without:
#   1. An approved product specification for offer management (spec §8a).
#   2. Restoring partner-level authorization on the backend endpoints.
# HIGH-1 fix (review r2u): documenting this flag so operators know it exists.
VITE_OFFER_MANAGEMENT_ENABLED=false

# ===========================================
# OAuth (Google / Facebook login)
# Currently behind "Coming Soon" overlay in LoginPage.tsx.
# When activating OAuth:
#   1. Set real values here AND in the Vercel project dashboard (Production + Preview).
#   2. Do NOT commit real credentials to this file — use Vercel dashboard env vars.
#   3. Remove the ComingSoonWrapper overlay from LoginPage.tsx.
# ===========================================
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
VITE_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID

# ===========================================
# Cache Configuration
# ===========================================
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL=3600
