# Supabase Configuration
# Get these from your Supabase project settings

# Database connection string (use the pooler connection string)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase project URL
SUPABASE_URL=https://[project-ref].supabase.co

# Supabase anonymous key (safe for client-side)
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service key (keep secret, server-side only)
SUPABASE_SERVICE_KEY=your-service-key-here

# Direct database connection (for migrations)
POSTGRES_PRISMA_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# JWT Secret for auth service
JWT_SECRET=your-super-secret-jwt-key-here

# API Gateway Port (development)
PORT=3100

# Redis (will be from Upstash)
REDIS_URL=redis://default:[password]@[endpoint].upstash.io:6379

# API URLs (Fly.io production)
API_BASE_URL=https://boomcard-api.fly.dev

# Environment
NODE_ENV=production

# Playwright smoke-test / audit scripts (scripts/audit-receipts.js, scripts/smoke-test-*.js)
# Use a dedicated non-privileged test account, not a real production login.
BOOMCARD_TEST_EMAIL=test-account@example.com
BOOMCARD_TEST_PASSWORD=your-test-account-password-here